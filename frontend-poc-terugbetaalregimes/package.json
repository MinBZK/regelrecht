{
  "name": "poc-terugbetaalregimes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PoC: de vier terugbetaalregimes voor studieschulden (OCW/DUO), met burger-, scenario- en beleidsview op de WASM-engine",
  "scripts": {
    "predev": "node scripts/copy-assets.js",
    "dev": "vite",
    "prebuild": "node scripts/copy-assets.js",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "node scripts/copy-assets.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "nldd:imports": "node ../script/check-nldd-imports.mjs src src/nldd-components.js --write",
    "nldd:check": "node ../script/check-nldd-imports.mjs src src/nldd-components.js"
  },
  "dependencies": {
    "@cucumber/gherkin": "^41.0.0",
    "@cucumber/messages": "^34.0.1",
    "@nldd/design-system": "^0.8.88",
    "echarts": "^6.1.0",
    "js-yaml": "^5.4.1",
    "vue": "^3.5.42",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "happy-dom": "^20.12.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
