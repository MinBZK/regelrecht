---
/*
 * The documentation overview at the top of /guide/what-is-regelrecht (where
 * the "Documentatie" nav lands). Two boxed nldd-lists:
 *  1. Quick actions (how-it-works / get-started / GitHub).
 *  2. The six capability cards, each linking to the relevant docs section.
 */
const cards = [
  {
    title: 'Executable Law',
    body: 'Dutch legislation encoded in YAML and executed by a deterministic engine. Every decision traces back to its legal source.',
    href: '/concepts/how-it-works',
  },
  {
    title: 'Cross-Law References',
    body: 'Laws reference each other just as in statute books. The engine resolves dependencies automatically across the entire corpus.',
    href: '/concepts/cross-law-references',
  },
  {
    title: 'Delegation',
    body: 'Laws leave values to ministerial regulations and municipal ordinances. The engine discovers implementations when it loads the corpus, matching the real legal hierarchy.',
    href: '/concepts/inversion-of-control',
  },
  {
    title: 'Scenario Testing',
    body: 'Scenarios, many taken from the worked examples in the Memorie van Toelichting, check each interpretation by running it. How experts establish that an interpretation is legally sound is a method still being developed.',
    href: '/concepts/methodology',
  },
  {
    title: 'Multi-Organization Execution',
    body: 'Different government organizations handle different laws. The engine models these boundaries; exchanging signed results between organizations is proposed (RFC-009) but not yet built.',
    href: '/concepts/multi-org-execution',
  },
  {
    title: 'Open Source',
    body: 'Developed by the Nederlandse Digitale Dienst (Ministry of Economic Affairs and Climate Policy); the work began at the Ministry of the Interior, whose GitHub organization hosts the repository. Everything from the law files to the design decisions is public.',
    href: 'https://github.com/MinBZK/regelrecht',
  },
];

const actions = [
  { text: 'How It Works', href: '/concepts/how-it-works' },
  { text: 'Get Started', href: '/guide/getting-started' },
  { text: 'GitHub', href: 'https://github.com/MinBZK/regelrecht' },
];
---

<nldd-list variant="box-tinted">
  {
    actions.map((a) => (
      <nldd-list-item href={a.href}>
        <nldd-text-cell text={a.text} />
        <nldd-spacer-cell size="8" />
        <nldd-icon-cell size="20" icon="chevron-right" />
      </nldd-list-item>
    ))
  }
</nldd-list>
<nldd-list variant="box-tinted">
  {
    cards.map((c) => (
      <nldd-list-item href={c.href}>
        <nldd-text-cell text={c.title} supporting-text={c.body} />
        <nldd-spacer-cell size="8" />
        <nldd-icon-cell size="20" icon="chevron-right" />
      </nldd-list-item>
    ))
  }
</nldd-list>
