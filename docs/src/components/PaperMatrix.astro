---
/*
 * A yes/partly/no matrix for the plain-language paper page, as a list: who can
 * do what (step 2) and Table 1 (step 8).
 *
 * One row per actor or approach, with a tag for each column that applies ("ja",
 * or the column with "deels" behind it) and the `none` text when nothing does.
 * A "nee" is the absence of a tag. That reads the same on a phone and on a wide
 * screen, so there is one rendering and no table that has to scroll sideways or
 * be swapped for another layout below a breakpoint.
 *
 * Only NLDD components: nldd-list, nldd-list-item, nldd-text-cell, nldd-tag.
 */
import type { Cell } from '~/lib/paper-explained-content';

interface Row {
  label: string;
  cells: Cell[];
}

interface Props {
  label: string;
  columns: string[];
  rows: Row[];
  words: { yes: string; part: string; no: string };
  /** Shown for a row where no column applies. */
  none: string;
  appearance?: 'simple' | 'box-tinted' | 'box-base';
}

const { label, columns, rows, words, none, appearance = 'box-base' } = Astro.props;

const color = (v: Cell['v']) => (v === 'yes' ? 'success' : v === 'part' ? 'warning' : 'neutral');
---

<nldd-list accessible-label={label} appearance={appearance}>
  {
    rows.map((row) => {
      const applies = row.cells
        .map((c, i) => ({ ...c, column: columns[i] }))
        .filter((c) => c.v !== 'no');
      const notes = row.cells.filter((c) => c.note).map((c) => c.note);
      return (
        <nldd-list-item>
          <nldd-text-cell text={row.label} vertical-alignment="top">
            <nldd-container slot="supporting-text" layout="wrap" gap="4">
              {applies.length === 0 && <nldd-text size="sm" color="secondary">{none}</nldd-text>}
              {applies.map((c) => (
                <nldd-tag
                  size="sm"
                  color={color(c.v)}
                  text={c.v === 'part' ? `${c.column} (${words.part})` : c.column}
                />
              ))}
              {notes.length > 0 && <nldd-text size="sm" color="secondary">{notes.join('; ')}</nldd-text>}
            </nldd-container>
          </nldd-text-cell>
        </nldd-list-item>
      );
    })
  }
</nldd-list>
