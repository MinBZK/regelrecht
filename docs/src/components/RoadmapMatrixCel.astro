---
/*
 * One matrix cell: the stack of werkpakket-cards for a fase/discipline
 * combination.
 *
 * Split out of index.astro so the cell markup lives in one place instead of
 * being inlined once per fase column in the matrix template. The card itself
 * is RoadmapKaart.astro, shared with the bord: what a werkpakket looks like
 * does not depend on which weergave it is on.
 *
 * Where a card sits is not decided here. The dependency view places the cards
 * in the browser, over the ones that are actually on screen; see the script in
 * index.astro. Deciding it at build time put the layout and the filters on
 * different clocks, and a filtered-away card then left a hole in the matrix.
 */
import RoadmapKaart from '~/components/RoadmapKaart.astro';
import type { WerkpakketData } from '~/lib/roadmap';

interface Props {
  cel: { data: WerkpakketData }[];
  class?: string;
  /** Space-separated header ids: swimlane, discipline, fase — see index.astro. */
  headers: string;
}

const { cel, class: className, headers } = Astro.props;
---

<td class:list={['rr-matrix__cell', className]} headers={headers}>
  {/*
     A plain element rather than an nldd-container: with the dependency view on
     this becomes a two-axis grid (a column per step of dependency, a row per
     chain), and a container stacks in one direction only. Off, it is the same
     stack of cards with the same gap the container gave it.
  */}
  <div class="rr-cel-raster">
    {cel.map((wp) => <RoadmapKaart wp={wp} />)}
  </div>
</td>
