---
/*
 * Eén onderzoeksvraag als kaart op het vragenbord, in dezelfde vorm als de
 * werkpakketkaart (RoadmapKaart.astro): de vraag als titel, het werkpakket
 * als ondertitel, een rij tags, en een stille regel eronder.
 *
 * De kaart is een knop, geen link: drukken opent het detailpaneel naast de
 * lijst (zie pages/roadmap/onderzoeksvragen.astro), met het doel, de
 * deelvragen en de verwante vragen, zonder van scherm te wisselen. De kaart
 * en zijn paneel vinden elkaar op `data-vraag`. De kaart draagt dezelfde
 * `data-zoek` als de werkpakketkaart, zodat het zoekveld in de kop hem vindt,
 * en `data-lane` voor het standfilter.
 */
import {
  getOnderzoek,
  getBelegging,
  vraagLane,
  vraagZoektekst,
  telDeelvragen,
  werkpakketTags,
  rfcTekst,
  type KaartTag,
  type Onderzoeksvraag,
  type WerkpakketData,
} from '~/lib/roadmap';

interface Props {
  vraag: Onderzoeksvraag;
  werkpakket: WerkpakketData;
  /** De sleutel die kaart en detailpaneel delen; zie vragenOpVolgorde(). */
  sleutel: string;
}

const { vraag, werkpakket, sleutel } = Astro.props;

const { lane, eigen } = vraagLane(vraag, werkpakket);
const status = getOnderzoek(vraag.status);
const belegging = getBelegging(werkpakket.belegging.stand);
const deel = telDeelvragen(vraag);

const tags: KaartTag[] = [
  // De eigen status van de vraag als tag; zonder eigen status de belegging
  // van het werkpakket, met "werkpakket" ervoor, want dat is waar de lane
  // dan vandaan komt. Vrij krijgt geen tag, net als op de werkpakketkaart.
  status
    ? { color: status.tagColor, text: status.label, label: `Status ${status.label}` }
    : undefined,
  !status && belegging && belegging.id !== 'vrij'
    ? {
        color: belegging.tagColor,
        text: `werkpakket ${belegging.label.toLowerCase()}`,
        icon: belegging.id === 'klaar' ? 'done' : 'user',
        label: `Werkpakket ${belegging.label.toLowerCase()}`,
      }
    : undefined,
  // Daarna de tags van het werkpakket (prioriteit, omvang, categorie,
  // capability), dezelfde als op de werkpakketkaart: een vraag erft ze van
  // het pakket waar hij in staat, en zo leest een vraagkaart als een
  // werkpakketkaart.
  ...werkpakketTags(werkpakket),
].filter((t): t is KaartTag => t !== undefined);

const rfcs = rfcTekst(werkpakket);

const onder = [
  deel.totaal > 0 &&
    `${deel.beantwoord} van ${deel.totaal} ${deel.totaal === 1 ? 'deelvraag' : 'deelvragen'} beantwoord`,
  vraag.verwant.length > 0 &&
    `${vraag.verwant.length} verwante ${vraag.verwant.length === 1 ? 'vraag' : 'vragen'}`,
]
  .filter(Boolean)
  .join(' · ');

// De papersectie als kopregel boven de vraag, want daar is de lijst op
// gesorteerd: wie door de kaarten loopt, loopt door het paper. Zonder sectie
// zegt de kopregel dat, zodat die kaarten niet lezen als een vergissing.
const kopregel = vraag.paper
  ? `§ ${vraag.paper.nummer} ${vraag.paper.titel}`
  : 'Zonder sectie in het paper';

const accessibleLabel = [kopregel, vraag.vraag, werkpakket.titel, ...tags.map((t) => t.label), rfcs, onder]
  .filter(Boolean)
  .join(', ');
---

<nldd-card
  class="rr-wp-card"
  button
  background={lane === 'opgepakt' ? 'tinted' : undefined}
  accessible-label={`${accessibleLabel}, details openen`}
  data-zoek={vraagZoektekst(vraag, werkpakket)}
  data-lane={lane}
  data-eigen={eigen ? 'ja' : undefined}
  data-vraag={sleutel}
>
  <nldd-container padding="12" gap="8">
    <nldd-container gap="2">
      {/* lang="en" op de sectietitel: die is Engels op een Nederlandse pagina. */}
      <nldd-text size="xs" weight="medium" color={vraag.paper ? 'accent' : 'secondary'}>
        {vraag.paper ? (
          <>§ {vraag.paper.nummer} <span lang="en">{vraag.paper.titel}</span></>
        ) : (
          kopregel
        )}
      </nldd-text>
      <nldd-text size="sm" weight="medium">{vraag.vraag}</nldd-text>
      <nldd-text size="xs" color="secondary">{werkpakket.titel}</nldd-text>
    </nldd-container>
    {(tags.length > 0 || rfcs) && (
      <nldd-container layout="wrap" gap="4" vertical-alignment="center">
        {tags.map((tag) => (
          <nldd-tag
            color={tag.color}
            text={tag.text}
            icon={tag.icon}
            accessible-label={tag.label}
            size="sm"
          />
        ))}
        {rfcs && <nldd-text size="xs" color="secondary">{rfcs}</nldd-text>}
      </nldd-container>
    )}
    {onder && <nldd-text size="xs" color="secondary">{onder}</nldd-text>}
  </nldd-container>
</nldd-card>
