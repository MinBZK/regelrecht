---
/*
 * One card in a landing-page collection: title, meta line, body text and a
 * full-width "Lees …"/"Read …" button. The research and references sections
 * render the same card; `tinted` picks the card surface for a section on the
 * plain page background (a tinted section uses plain cards). `headingLevel`
 * is the rank of the title in the page outline: 3 under a section heading, as
 * on the landing page, 2 where the card sits directly under the page's h1. The
 * visual size stays the same either way. `also` adds a second button under
 * the first, for a companion to the same item (the paper's plain-language
 * explainer), so it does not need a card of its own.
 */
interface Props {
  lang: 'nl' | 'en';
  title: string;
  meta: string;
  text: string;
  href: string;
  linkLabel: string;
  tinted?: boolean;
  headingLevel?: 2 | 3;
  also?: { href: string; linkLabel: string };
}

const {
  lang,
  title,
  meta,
  text,
  href,
  linkLabel,
  tinted = false,
  headingLevel = 3,
  also,
} = Astro.props;
const read = lang === 'en' ? 'Read' : 'Lees';
const Heading = `h${headingLevel}`;
---

<nldd-card
  background={tinted ? 'tinted' : undefined}
  accessible-label={title}
>
  <nldd-container padding="20" padding-bottom="12">
    <nldd-title size="3">
      <Heading>{title}</Heading>
      <p slot="supporting-text">{meta}</p>
    </nldd-title>
    <nldd-spacer size="12" />
    <nldd-rich-text>
      <p>{text}</p>
    </nldd-rich-text>
  </nldd-container>
  <nldd-container slot="footer" padding="20" padding-top="0" gap="8">
    <nldd-button
      appearance="secondary"
      width="full"
      href={href}
      text={`${read} ${linkLabel}`}
      accessible-label={`${read} ${linkLabel}: ${title}`}
    />
    {also && (
      <nldd-button
        appearance="secondary"
        width="full"
        href={also.href}
        text={`${read} ${also.linkLabel}`}
        accessible-label={`${read} ${also.linkLabel}: ${title}`}
      />
    )}
  </nldd-container>
</nldd-card>
