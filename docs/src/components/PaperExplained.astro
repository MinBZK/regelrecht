---
/*
 * The position paper "Rules as Executed" in plain language, in nine steps that
 * follow the paper's own argument.
 *
 * The text is in ~/lib/paper-explained-content (Dutch source, English
 * translation); what is taken from the paper itself (Figure 1's YAML, Table 1,
 * the outline the "read this in the paper" links point into) comes out of the
 * generated paper HTML at build time through ~/lib/paper-explained, so it
 * cannot differ from what the paper says. The paper is frozen; this page
 * explains it and is not part of it.
 *
 * Interaction is progressive enhancement, as on the landing page. Without
 * JavaScript every alternative of every switch is shown, one under the other,
 * each under its own label, and the receipt panel says it needs JavaScript.
 * ~/scripts/paper-explained.ts adds the switching and the run.
 */
import {
  meta,
  section,
  codeFigure,
  landscape,
  type SectionRef,
} from '~/lib/paper-explained';
import { content, actors, type Lang, type Cell } from '~/lib/paper-explained-content';
import '~/styles/paper-explained.css';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const other = lang === 'nl' ? '/research/rules-as-executed/explained' : '/research/rules-as-executed/uitgelegd';

const date = new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'nl-NL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(meta.date));
const doiUrl = `https://doi.org/${meta.doi}`;
const discussionUrl =
  'https://github.com/MinBZK/regelrecht/issues?q=' +
  encodeURIComponent(`is:issue label:contribution:paper "${meta.title}" sort:updated-desc`);

const figureOne = codeFigure('fig:narra-example');
const table = landscape();
const matrix = actors(lang);

// The chapters in order, with the sections of the paper each one explains.
const chapters: { id: string; title: string; refs: SectionRef[] }[] = [
  { id: 'gepubliceerd', title: t.published.title, refs: [section('sec:introduction'), section('sec:intelligibilitygap')] },
  { id: 'macht', title: t.power.title, refs: [section('sec:executivedominance'), section('sec:substitute'), section('sec:broaderpattern')] },
  { id: 'binding', title: t.binding.title, refs: [section('sec:format'), section('sec:legalstatus'), section('sec:whochooses')] },
  { id: 'bonnetje', title: t.receipt.title, refs: [section('sec:attestation'), section('sec:traceaccess')] },
  { id: 'standaard', title: t.default.title, refs: [section('sec:overrides'), section('sec:autooverrides')] },
  { id: 'ambt', title: t.offices.title, refs: [section('sec:actors'), section('sec:readers'), section('sec:conclusion')] },
  { id: 'blootleggen', title: t.diagnose.title, refs: [section('sec:structuralanalysis'), section('sec:untranslatables'), section('sec:lawmaking'), section('sec:pathoptimization')] },
  { id: 'rules-as-code', title: t.veterans.title, refs: [section('sec:priorwork'), section('sec:cnl'), section('sec:translation')] },
  { id: 'grenzen', title: t.limits.title, refs: [section('sec:cannotbuildback'), section('sec:gaming'), section('sec:agenda')] },
];
const ch = Object.fromEntries(chapters.map((c, i) => [c.id, { ...c, n: i + 1 }]));

const tagColor = (v: Cell['v']) => (v === 'yes' ? 'success' : v === 'part' ? 'warning' : 'neutral');
const tagText = (v: Cell['v']) => (v === 'yes' ? t.yes : v === 'part' ? t.part : t.no);
---

{/* Shared markup for the end of each chapter: where to read on in the paper. */}

<nldd-simple-section sm-padding-block="32" md-padding-block="48" lg-padding-block="64">
  <nldd-title size="1">
    <h1>{t.header.title}</h1>
    <p slot="subtitle">{t.header.subtitle}</p>
  </nldd-title>
  <nldd-spacer size="16" />
  <nldd-rich-text>
    <p class="rr-px-lede">{t.header.lede}</p>
  </nldd-rich-text>
  <nldd-spacer size="16" />
  <nldd-banner variant="neutral" size="sm" text={t.header.version(date)} supporting-text={t.header.engineNote} />
  <nldd-spacer size="16" />
  <nldd-container layout="wrap" gap="16">
    <nldd-link href="#rules-as-code" size="md" end-icon="chevron-right" text={t.header.veterans} />
  </nldd-container>
  <nldd-spacer size="8" />
  <nldd-container layout="wrap" gap="16">
    <nldd-link href="/research/rules-as-executed" size="md" text={t.header.paper} />
    <nldd-link href={doiUrl} size="md" text={t.header.pdf} />
    <nldd-link href={other} lang={lang === 'nl' ? 'en' : 'nl'} hreflang={lang === 'nl' ? 'en' : 'nl'} size="md" text={t.header.otherLang} />
  </nldd-container>
  <nldd-spacer size="24" />
  <nav aria-label={t.header.tocLabel}>
    <nldd-title size="5"><h2>{t.header.tocLabel}</h2></nldd-title>
    <nldd-spacer size="8" />
    <ol class="rr-px-toc">
      {chapters.map((c) => (
        <li><nldd-link href={`#${c.id}`} text={c.title} /></li>
      ))}
    </ol>
  </nav>
</nldd-simple-section>

{/* 1 ------------------------------------------------------------------ */}
<nldd-simple-section id={ch.gepubliceerd.id} background="tinted" sm-padding-block="32" md-padding-block="48" lg-padding-block="64">
  <p class="rr-px-step">{t.step} {ch.gepubliceerd.n}</p>
  <nldd-title size="2"><h2>{t.published.title}</h2></nldd-title>
  <nldd-spacer size="16" />
  <nldd-rich-text><p>{t.published.p1}</p></nldd-rich-text>
  <nldd-spacer size="24" />

  <ol class="rr-px-flow" aria-label={t.published.caseLabel}>
    {t.published.layers.map((l) => (
      <li class:list={['rr-px-flow__step', l.hidden && 'rr-px-flow__step--hidden']}>
        <nldd-card background="base">
<nldd-container padding="20">
          <nldd-tag size="sm" color={l.hidden ? 'warning' : 'success'} text={l.tag} />
<nldd-spacer size="8" />
          <nldd-title size="5"><h3>{l.label}</h3></nldd-title>
          <nldd-text size="sm" color="secondary">{l.text}</nldd-text>
        </nldd-container>
</nldd-card>
      </li>
    ))}
  </ol>
  <nldd-spacer size="24" />

  <nldd-card background="base" accessible-label={t.published.caseLabel}>
<nldd-container padding="20">
    <nldd-rich-text><p>{t.published.caseIntro}</p></nldd-rich-text>
    <nldd-spacer size="12" />
    <rr-px-switch data-default={t.published.options[0].id}>
      <nldd-title size="5"><h3 id="px-case-label">{t.published.caseLabel}</h3></nldd-title>
      <nldd-spacer size="8" />
      <nldd-segmented-control accessible-labeled-by="px-case-label" width="fit-content" data-control hidden>
        {t.published.options.map((o) => <nldd-segmented-control-item value={o.id} text={o.label} />)}
      </nldd-segmented-control>
      <nldd-spacer size="12" />
      <div aria-live="polite">
        {t.published.options.map((o) => (
          <div class="rr-px-panel" data-panel={o.id}>
            <nldd-text size="sm" weight="bold" class="rr-px-panel__label">{o.label}</nldd-text>
            <nldd-container layout="row" gap="8" vertical-alignment="center">
              <nldd-tag color={o.tone} text={o.tag} />
              <nldd-text>{o.outcome}</nldd-text>
            </nldd-container>
          </div>
        ))}
      </div>
    </rr-px-switch>
    <nldd-spacer size="12" />
    <nldd-text size="sm" color="secondary">{t.published.caseNote}</nldd-text>
  </nldd-container>
</nldd-card>
  <nldd-spacer size="24" />

  <nldd-rich-text><p>{t.published.p2}</p></nldd-rich-text>
  <nldd-spacer size="24" />
  <nldd-card background="base" accessible-label={t.published.demandLabel}>
<nldd-container padding="20">
    <nldd-tag size="sm" color="accent" text={t.published.demandLabel} />
<nldd-spacer size="8" />
    <p class="rr-px-demand">{t.published.demand}</p>
  </nldd-container>
</nldd-card>
  <nldd-spacer size="16" />
  <nldd-rich-text><p>{t.published.p3}</p></nldd-rich-text>
  <nldd-spacer size="24" />
  <nav class="rr-px-refs" aria-label={t.readInPaper}>
    <nldd-text size="sm" weight="bold">{t.readInPaper}</nldd-text>
    <ul>{ch.gepubliceerd.refs.map((r: SectionRef) => <li><nldd-link href={r.href} size="sm" text={`§ ${r.label}`} /></li>)}</ul>
  </nav>
</nldd-simple-section>

{/* 2 ------------------------------------------------------------------ */}
<nldd-simple-section id={ch.macht.id} sm-padding-block="32" md-padding-block="48" lg-padding-block="64">
  <p class="rr-px-step">{t.step} {ch.macht.n}</p>
  <nldd-title size="2"><h2>{t.power.title}</h2></nldd-title>
  <nldd-spacer size="16" />
  <nldd-rich-text><p>{t.power.p1}</p><p>{t.power.p2}</p></nldd-rich-text>
  <nldd-spacer size="24" />

  <rr-px-switch data-default="now">
    <nldd-title size="5"><h3 id="px-matrix-now">{t.power.matrixLabel}</h3></nldd-title>
    <nldd-spacer size="8" />
    <nldd-segmented-control accessible-labeled-by="px-matrix-now" width="fit-content" data-control hidden>
      <nldd-segmented-control-item value="now" text={t.now} />
      <nldd-segmented-control-item value="proposal" text={t.proposal} />
    </nldd-segmented-control>
    <nldd-spacer size="12" />
    {(['now', 'proposal'] as const).map((state) => (
      <div class="rr-px-panel" data-panel={state}>
        <nldd-text size="sm" weight="bold" class="rr-px-panel__label">{state === 'now' ? t.now : t.proposal}</nldd-text>
        <nldd-table
          accessible-label={`${t.power.matrixLabel} ${state === 'now' ? t.now : t.proposal}`}
          background="base"
          columns="minmax(150px, 1.2fr) repeat(3, minmax(120px, 1fr))"
        >
          <nldd-table-row slot="header">
            <nldd-cell width="full"><nldd-text weight="bold" size="sm">&nbsp;</nldd-text></nldd-cell>
            {t.power.columns.map((c) => <nldd-cell width="full"><nldd-text weight="bold" size="sm">{c}</nldd-text></nldd-cell>)}
          </nldd-table-row>
          {matrix.map((row) => (
            <nldd-table-row>
              <nldd-cell width="full" vertical-alignment="top"><nldd-text size="sm" weight="medium">{row.actor}</nldd-text></nldd-cell>
              {row[state].map((c) => (
                <nldd-cell width="full" vertical-alignment="top">
                  <nldd-container gap="4">
                    <nldd-tag size="sm" color={tagColor(c.v)} text={tagText(c.v)} />
                    {c.note && <nldd-text size="xs" color="secondary">{c.note}</nldd-text>}
                  </nldd-container>
                </nldd-cell>
              ))}
            </nldd-table-row>
          ))}
        </nldd-table>
      </div>
    ))}
  </rr-px-switch>
  <nldd-spacer size="24" />
  <nldd-rich-text><p>{t.power.p3}</p><p>{t.power.p4}</p></nldd-rich-text>
  <nldd-spacer size="24" />
  <nav class="rr-px-refs" aria-label={t.readInPaper}>
    <nldd-text size="sm" weight="bold">{t.readInPaper}</nldd-text>
    <ul>{ch.macht.refs.map((r: SectionRef) => <li><nldd-link href={r.href} size="sm" text={`§ ${r.label}`} /></li>)}</ul>
  </nav>
</nldd-simple-section>

{/* 3 ------------------------------------------------------------------ */}
<nldd-simple-section id={ch.binding.id} background="tinted" sm-padding-block="32" md-padding-block="48" lg-padding-block="64">
  <p class="rr-px-step">{t.step} {ch.binding.n}</p>
  <nldd-title size="2"><h2>{t.binding.title}</h2></nldd-title>
  <nldd-spacer size="16" />
  <nldd-rich-text><p>{t.binding.p1}</p></nldd-rich-text>
  <nldd-spacer size="24" />

  <rr-px-switch data-default="now">
    <nldd-title size="5"><h3 id="px-flow">{t.binding.flowLabel}</h3></nldd-title>
    <nldd-spacer size="8" />
    <nldd-segmented-control accessible-labeled-by="px-flow" width="fit-content" data-control hidden>
      <nldd-segmented-control-item value="now" text={t.now} />
      <nldd-segmented-control-item value="proposal" text={t.proposal} />
    </nldd-segmented-control>
    <nldd-spacer size="12" />
    {([
      ['now', t.now, t.binding.flowNow, t.binding.flowNowNote],
      ['proposal', t.proposal, t.binding.flowProposal, t.binding.flowProposalNote],
    ] as const).map(([id, label, steps, note]) => (
      <div class="rr-px-panel" data-panel={id}>
        <nldd-text size="sm" weight="bold" class="rr-px-panel__label">{label}</nldd-text>
        <ol class="rr-px-flow">
          {steps.map((s) => (
            <li class:list={['rr-px-flow__step', id === 'proposal' && s === steps[1] && 'rr-px-flow__step--key']}>
              <nldd-card background="base">
<nldd-container padding="20">
                <nldd-title size="5"><h4>{s.label}</h4></nldd-title>
                <nldd-text size="sm" color="secondary">{s.text}</nldd-text>
              </nldd-container>
</nldd-card>
            </li>
          ))}
        </ol>
        <nldd-spacer size="8" />
        <nldd-text size="sm">{note}</nldd-text>
      </div>
    ))}
  </rr-px-switch>
  <nldd-spacer size="24" />

  <nldd-rich-text><p>{t.binding.p2}</p></nldd-rich-text>
  <nldd-spacer size="16" />
  <nldd-card background="base" accessible-label={t.binding.exampleLabel}>
<nldd-container padding="20">
    <nldd-title size="5"><h3>{t.binding.exampleLabel}</h3></nldd-title>
<nldd-spacer size="8" />
    <nldd-blockquote>
      <p>{t.binding.exampleStatute}</p>
    </nldd-blockquote>
    <nldd-spacer size="16" />
    <nldd-table
      accessible-label={t.binding.exampleLabel}
      background="tinted"
      columns="minmax(160px, 1fr) minmax(200px, 1.3fr) minmax(140px, 1fr)"
      sm-columns="minmax(140px, 1fr) minmax(180px, 1.3fr)"
    >
      <nldd-table-row slot="header">
        {t.binding.mapColumns.map((c, i) => (
          <nldd-cell width="full" hide-below={i === 2 ? 'md' : undefined}><nldd-text weight="bold" size="sm">{c}</nldd-text></nldd-cell>
        ))}
      </nldd-table-row>
      {t.binding.mapRows.map(([phrase, rule, source]) => (
        <nldd-table-row>
          <nldd-cell width="full" vertical-alignment="top"><nldd-text size="sm">{phrase}</nldd-text></nldd-cell>
          <nldd-cell width="full" vertical-alignment="top"><nldd-text size="sm"><code class="rr-px-code">{rule}</code></nldd-text></nldd-cell>
          <nldd-cell width="full" vertical-alignment="top" hide-below="md"><nldd-text size="sm" color="secondary">{source}</nldd-text></nldd-cell>
        </nldd-table-row>
      ))}
    </nldd-table>
    <nldd-spacer size="12" />
    <nldd-text size="sm" color="secondary">{t.binding.exampleNote}</nldd-text>
    <nldd-spacer size="12" />
    <details class="rr-px-facts">
      <summary>{t.binding.showListing}</summary>
      <nldd-spacer size="8" />
      <nldd-code-viewer language="yaml" variant="simple" wrap set:html={figureOne.codeHtml} />
      <nldd-spacer size="8" />
      <nldd-link href={figureOne.href} size="sm" text={figureOne.caption.split(':')[0]} />
    </details>
  </nldd-container>
</nldd-card>
  <nldd-spacer size="24" />
  <nldd-rich-text><p>{t.binding.p3}</p><p>{t.binding.p4}</p></nldd-rich-text>
  <nldd-spacer size="24" />
  <nav class="rr-px-refs" aria-label={t.readInPaper}>
    <nldd-text size="sm" weight="bold">{t.readInPaper}</nldd-text>
    <ul>{ch.binding.refs.map((r: SectionRef) => <li><nldd-link href={r.href} size="sm" text={`§ ${r.label}`} /></li>)}</ul>
  </nav>
</nldd-simple-section>

{/* 4 ------------------------------------------------------------------ */}
<nldd-simple-section id={ch.bonnetje.id} sm-padding-block="32" md-padding-block="48" lg-padding-block="64">
  <p class="rr-px-step">{t.step} {ch.bonnetje.n}</p>
  <nldd-title size="2"><h2>{t.receipt.title}</h2></nldd-title>
  <nldd-spacer size="16" />
  <nldd-rich-text><p>{t.receipt.p1}</p><p>{t.receipt.p2}</p></nldd-rich-text>
  <nldd-spacer size="24" />

  <rr-px-receipts
    data-lang={lang}
    data-t={JSON.stringify({
      ok: t.receipt.ok,
      mismatch: t.receipt.mismatch,
      checking: t.receipt.checking,
      check: t.receipt.check,
      failed: t.receipt.failed,
      revealA: t.receipt.revealA,
    })}
    data-reveal-b={t.receipt.revealB('{published}', '{local}', '{diff}')}
    data-inputs-summary={t.receipt.inputsSummary(999).replace('999', '{n}')}
  >
    <nldd-rich-text><p>{t.receipt.demoIntro}</p></nldd-rich-text>
    <nldd-spacer size="16" />
    <p class="rr-px-status" data-status aria-live="polite" hidden>{t.receipt.loading}</p>
    <noscript><nldd-text>{t.receipt.noScript}</nldd-text></noscript>
    <nldd-collection layout="grid" item-width="300px" data-receipts hidden>
      {(['a', 'b'] as const).map((id) => (
        <nldd-card background="tinted" accessible-label={`${t.receipt.decision} ${id.toUpperCase()}`} data-receipt={id}>
<nldd-container padding="20">
          <nldd-title size="4"><h3>{t.receipt.decision} {id.toUpperCase()}</h3></nldd-title>
<nldd-spacer size="8" />
          <dl class="rr-px-receipt">
            <div><dt>{t.receipt.fields.law}</dt><dd>Wet op de zorgtoeslag</dd></div>
            <div><dt>{t.receipt.fields.version}</dt><dd data-f="version"></dd></div>
            <div><dt>{t.receipt.fields.digest}</dt><dd class="rr-px-digest" data-f="digest"></dd></div>
            <div><dt>{t.receipt.fields.date}</dt><dd data-f="date"></dd></div>
            <div><dt>{t.receipt.fields.inputs}</dt><dd data-f="inputs"></dd></div>
            <div class="rr-px-receipt__amount"><dt>{t.receipt.fields.amount}</dt><dd data-f="amount"></dd></div>
          </dl>
          <nldd-spacer size="12" />
          <ul class="rr-px-checks" data-checks hidden>
            <li><nldd-tag size="sm" data-check="digest" /> <nldd-text size="sm">{t.receipt.checkDigest}</nldd-text></li>
            <li><nldd-tag size="sm" data-check="amount" /> <nldd-text size="sm">{t.receipt.checkAmount}</nldd-text></li>
          </ul>
          <nldd-text size="sm" data-reveal hidden></nldd-text>
          <nldd-spacer size="12" />
<nldd-button variant="primary" size="sm" text={t.receipt.check} data-check-button />
        </nldd-container>
</nldd-card>
      ))}
    </nldd-collection>
    <nldd-spacer size="16" />
    <details class="rr-px-facts" data-facts hidden>
      <summary>{t.receipt.fields.inputs}</summary>
      <ul data-facts-list></ul>
    </details>
  </rr-px-receipts>
  <nldd-spacer size="16" />
  <nldd-text size="sm" color="secondary">{t.receipt.disclaimer}</nldd-text>
  <nldd-spacer size="24" />
  <nldd-rich-text><p>{t.receipt.p3}</p></nldd-rich-text>
  <nldd-spacer size="24" />
  <nldd-title size="4"><h3>{t.receipt.limitsLabel}</h3></nldd-title>
  <nldd-spacer size="8" />
  <nldd-rich-text>
    <ul>{t.receipt.limits.map((l) => <li>{l}</li>)}</ul>
  </nldd-rich-text>
  <nldd-spacer size="24" />
  <nav class="rr-px-refs" aria-label={t.readInPaper}>
    <nldd-text size="sm" weight="bold">{t.readInPaper}</nldd-text>
    <ul>{ch.bonnetje.refs.map((r: SectionRef) => <li><nldd-link href={r.href} size="sm" text={`§ ${r.label}`} /></li>)}</ul>
  </nav>
</nldd-simple-section>

{/* 5 ------------------------------------------------------------------ */}
<nldd-simple-section id={ch.standaard.id} background="tinted" sm-padding-block="32" md-padding-block="48" lg-padding-block="64">
  <p class="rr-px-step">{t.step} {ch.standaard.n}</p>
  <nldd-title size="2"><h2>{t.default.title}</h2></nldd-title>
  <nldd-spacer size="16" />
  <nldd-rich-text><p>{t.default.p1}</p></nldd-rich-text>
  <nldd-spacer size="24" />
  <nldd-card background="base" accessible-label={t.default.variantsLabel}>
<nldd-container padding="20">
    <rr-px-switch data-default={t.default.variants[1].id}>
      <nldd-title size="5"><h3 id="px-override">{t.default.variantsLabel}</h3></nldd-title>
      <nldd-spacer size="8" />
      <nldd-segmented-control accessible-labeled-by="px-override" width="fit-content" data-control hidden>
        {t.default.variants.map((v) => <nldd-segmented-control-item value={v.id} text={v.label} />)}
      </nldd-segmented-control>
      <nldd-spacer size="12" />
      {t.default.variants.map((v) => (
        <div class="rr-px-panel" data-panel={v.id}>
          <nldd-text size="sm" weight="bold" class="rr-px-panel__label">{v.label}</nldd-text>
          <dl class="rr-px-receipt">
            {v.rows.map(([k, val]) => <div><dt>{k}</dt><dd>{val}</dd></div>)}
          </dl>
          <nldd-spacer size="8" />
          <nldd-text size="sm">{v.note}</nldd-text>
        </div>
      ))}
    </rr-px-switch>
    <nldd-spacer size="12" />
    <nldd-text size="sm" color="secondary">{t.default.p2}</nldd-text>
  </nldd-container>
</nldd-card>
  <nldd-spacer size="24" />
