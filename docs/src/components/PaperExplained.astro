  <nldd-spacer size="24" />

  <nldd-card background="base" accessible-label={t.diagnose.orderLabel}>
<nldd-container padding="20">
    <rr-px-switch data-default="age">
      <nldd-title size="5"><h3 id="px-order">{t.diagnose.orderLabel}</h3></nldd-title>
      <nldd-spacer size="8" />
      <nldd-text size="sm">{t.diagnose.orderIntro}</nldd-text>
      <nldd-spacer size="12" />
      <nldd-segmented-control accessible-labeled-by="px-order" width="fit-content" data-control hidden>
        {t.diagnose.orderOptions.map((o) => <nldd-segmented-control-item value={o.id} text={o.label} />)}
      </nldd-segmented-control>
      <nldd-spacer size="12" />
      {t.diagnose.orderOptions.map((o) => {
        const order = o.id === 'age' ? [0, 1] : [1, 0];
        return (
          <div class="rr-px-panel" data-panel={o.id}>
            <nldd-text size="sm" weight="bold" class="rr-px-panel__label">{o.label}</nldd-text>
            <ol class="rr-px-path">
              {order.map((i, pos) => {
                // Age first: the age check settles it and detention is never
                // looked at. Detention first: detention is read, then age
                // settles it anyway.
                const consulted = o.id === 'detention' || i === 0;
                return (
                  <li class:list={['rr-px-path__step', !consulted && 'rr-px-path__step--skipped']}>
                    <nldd-tag size="sm" color={consulted ? (i === 1 ? 'warning' : 'neutral') : 'success'} text={consulted ? t.diagnose.consulted : t.diagnose.skipped} />
                    <span>
                      <nldd-text size="sm" weight="medium">{t.diagnose.steps[i].register}</nldd-text>
                      <nldd-text size="xs" color="secondary">{t.diagnose.steps[i].check}</nldd-text>
                    </span>
                  </li>
                );
              })}
            </ol>
            <nldd-text size="sm" weight="medium">{t.diagnose.stop}</nldd-text>
          </div>
        );
      })}
    </rr-px-switch>
    <nldd-spacer size="12" />
    <nldd-text size="sm" color="secondary">{t.diagnose.orderNote}</nldd-text>
  </nldd-container>
</nldd-card>
