---
/*
 * "Rules as Executed" in plain language (en). The page is the component;
 * see ~/components/PaperExplained.astro, and its twin in the other language
 * next to this file.
 */
import Base from '~/layouts/Base.astro';
import PaperExplained from '~/components/PaperExplained.astro';
import { content } from '~/lib/paper-explained-content';

const t = content.en;
---

<Base
  lang="en"
  kind="docs"
  pathname="/research/rules-as-executed/explained"
  title={t.meta.title}
  description={t.meta.description}
  hasSidebar={false}
>
  <PaperExplained lang="en" />
</Base>
