---
/*
 * /roadmap — werkpakketten on a fase x discipline matrix.
 *
 * A read-only rendering of src/content/roadmap/; editing goes through a pull
 * request (every werkpakket page links to its own source on GitHub). The app
 * this came from could add, move and delete werkpakketten against a write API;
 * none of that survives here, because the site is a static build behind nginx.
 *
 * The matrix is a real <table>: fases are columns, disciplines are rows, and a
 * screen reader needs that relationship to place a card. CSS gives it back the
 * grid layout (see roadmap.css). Disciplines are further grouped into
 * swimlanes (roadmap-config.json), rendered as a narrow vertical bar to the
 * left of the row-header column, one per swimlane, spanning down over all of
 * its rows; see `matrixRijen` below.
 *
 * The five fases (Fase I..V) are the Wat/Wat/Hoe/Waar/Garantie maturity
 * staging; each fase's ondertitel names both that stage and its theme (e.g.
 * "Wat · Fundering en definitie"). An earlier version of this page also cut
 * the Wat-fase into its own nested time-subkolommen (nu/half-jaar/later-ooit)
 * — a second axis stacked inside the first, which read as two unrelated
 * dimensions in one matrix and was dropped; see the discussion on PR #1356.
 */
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import RoadmapSectie from '~/components/RoadmapSectie.astro';
import RoadmapKop from '~/components/RoadmapKop.astro';
import RoadmapMatrixCel from '~/components/RoadmapMatrixCel.astro';
import {
  fases,
  swimlanes,
  getDiscipline,
  werkpakkettenInCel,
  assertReferencesResolve,
  assertFilterRules,
  type Discipline,
} from '~/lib/roadmap';
import '~/styles/roadmap.css';
// The stylesheet's own text, so the filter check below can read the rules it
// is about. ?raw gives the source; the ordinary import above is what ships.
import roadmapCss from '~/styles/roadmap.css?raw';

const werkpakketten = await getCollection('werkpakketten');
// Fails the build on a faseId, disciplineId or samenhangId that goes nowhere.
// check-links.mjs cannot see these: they end up on NLDD component attributes,
// not on <a href>.
assertReferencesResolve(werkpakketten);
// Fails the build when roadmap.css and the filters drift apart: a categorie
// without a show-rule, a verbergklasse without a hide-rule, or the
// afhankelijkheden switch read on the wrong attribute.
assertFilterRules(roadmapCss);

/*
 * One row per discipline, grouped under its swimlane —
 * assertSwimlanesMatchDisciplines() (lib/roadmap.ts) guarantees every
 * discipline is in exactly one, so this partitions all of them without
 * dropping or duplicating a row. The first row of each swimlane carries
 * `bar`: the swimlane's name plus how many rows (including its own) belong
 * to it, so the template can draw one vertical cell there spanning down —
 * the same rowspan-via-inline-grid-style technique the header uses for its
 * fase columns. Every later row of that swimlane leaves `bar` undefined; the
 * grid's own auto-placement skips the column there, the same way it already
 * skips columns under a rowspan header.
 *
 * `bar.zichtbaar` is false when a swimlane has exactly one discipline whose
 * name is identical to the swimlane's own — "Transitie-ondersteuning" and
 * "Samenwerking met andere initiatieven" both name themselves twice today.
 * The vertical bar and the row-header would then print the same word twice,
 * once sideways, right next to each other. The `<th>` still renders (the
 * accessible name stays, and the coloured/bordered bar keeps running the
 * full height of the matrix, uninterrupted), only its text is visually
 * hidden — `.rr-sr-only` in roadmap.css. Give the discipline a name distinct
 * from its swimlane's and both show.
 */
interface MatrixRow {
  discipline: Discipline;
  label: string;
  laneId: string;
  bar?: { naam: string; rowspan: number; zichtbaar: boolean };
}
const matrixRijen: MatrixRow[] = swimlanes.flatMap((lane) => {
  const laneDisciplines = lane.disciplineIds.map((id) => getDiscipline(id)!);
  return laneDisciplines.map((discipline, index) => ({
    discipline,
    label: discipline.naam,
    laneId: lane.id,
    bar:
      index === 0
        ? {
            naam: lane.naam,
            rowspan: laneDisciplines.length,
            zichtbaar: !(
              laneDisciplines.length === 1 && lane.naam === discipline.naam
            ),
          }
        : undefined,
  }));
});

// Ids for the `headers` attribute below: with two levels of row header (the
// swimlane bar spans several rows, the discipline header one), a screen
// reader can no longer infer the association from `scope` alone — pa11y's
// htmlcs runner flags exactly that ("multiple levels of th elements"). Every
// <td> names all three headers that apply to it explicitly instead.
const faseHeaderId = (faseId: string) => `rr-fase-${faseId}`;
const disciplineHeaderId = (disciplineId: string) => `rr-discipline-${disciplineId}`;
const swimlaneHeaderId = (laneId: string) => `rr-swimlane-${laneId}`;

const pathname = '/roadmap';
---

<Base
  lang="nl"
  kind="docs"
  pathname={pathname}
  noSearchIndex
  title="Roadmap · RegelRecht"
  description="Werkpakketten van RegelRecht, geordend per fase en discipline."
>
  {/*
    Twee maten op één pagina. RoadmapSectie zet de sectie met `vol` op de
    hele breedte, want de matrix is zeven kolommen breed en zou anders
    horizontaal scrollen binnen een maat die voor alinea's bedoeld is. De kop
    houdt de docs-maat (`.rr-roadmap__kop` in roadmap.css), zodat de titel en
    de balk op één lijn staan met de navigatie erboven en de voettekst eronder,
    en alleen de tabel uit die kolom breekt.
  */}
  <RoadmapSectie vol>
    <RoadmapKop
      huidig="matrix"
      ondertitel="Werkpakketten per fase en discipline. Deze weergave is read-only; wijzigen gaat via een pull request op GitHub."
      zoek={{ placeholder: 'Zoek in werkpakketten', noun: 'werkpakketten' }}
      filters={['categorie', 'belegging']}
      weergave
    />

    {/* tabindex + role make the horizontally scrolling matrix reachable by
        keyboard; without it axe flags scrollable-region-focusable. */}
    <div
      class="rr-matrix-scroll"
      tabindex="0"
      role="region"
      aria-label="Roadmapmatrix, horizontaal scrollbaar"
    >
      {/*
        The dependency overlay sits in its own positioned wrapper so the SVG
        can be placed against the table's own box rather than the scroll
        container's: the container scrolls, the table does not move inside
        it, and anchoring to the scroller would slide every arrow out of
        place the moment you pan sideways.

        aria-hidden: every werkpakket page lists the same dependencies under
        "Afhankelijkheden", as links. Reading the curves to a screen reader
        adds nothing that is not already there in text.
      */}
      <div class="rr-matrix-canvas">
        <svg class="rr-afhankelijk" aria-hidden="true" focusable="false"></svg>
        <table class="rr-matrix" style={`--rr-fase-count: ${fases.length}`}>
        <caption class="rr-matrix__caption">
          Werkpakketten per fase (kolommen) en discipline (rijen). De vijf
          fases zijn Wat (in twee stappen), Hoe, Waar en Garantie. De
          disciplines zijn gegroepeerd in vier swimlanes: Scope RegelRecht,
          Onderzoek, Samenwerking met andere initiatieven, en
          Transitie-ondersteuning.
        </caption>
        <thead>
          {/* Corner spans both the swimlane-bar column and the row-header
              column, so the fase headers start at the same column as the
              cards below them. */}
          <tr>
            <td
              class="rr-matrix__corner"
              colspan={2}
              style="grid-column: span 2"
            ></td>
            {
              fases.map((fase) => (
                <th
                  scope="col"
                  id={faseHeaderId(fase.id)}
                  class="rr-matrix__header rr-matrix__header--fase"
                >
                  <nldd-container gap="4" horizontal-alignment="center">
                    <nldd-text size="md" weight="bold">{fase.naam}</nldd-text>
                    {fase.ondertitel && (
                      <nldd-text size="xs" color="secondary">
                        {fase.ondertitel}
                      </nldd-text>
                    )}
                  </nldd-container>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            matrixRijen.map((rij) => (
                <tr>
                  {rij.bar && (
                    <th
                      scope="rowgroup"
                      id={swimlaneHeaderId(rij.laneId)}
                      rowspan={rij.bar.rowspan}
                      style={`grid-row: span ${rij.bar.rowspan}`}
                      class="rr-matrix__header rr-matrix__header--swimlanebalk"
                    >
                      <nldd-text
                        size="sm"
                        weight="bold"
                        class={rij.bar.zichtbaar ? undefined : 'rr-sr-only'}
                      >
                        {rij.bar.naam}
                      </nldd-text>
                    </th>
                  )}
                  <th
                    scope="row"
                    id={disciplineHeaderId(rij.discipline.id)}
                    class="rr-matrix__header rr-matrix__header--discipline"
                  >
                    <nldd-container gap="4">
                      <nldd-text size="md" weight="bold">{rij.label}</nldd-text>
                      {rij.discipline.ondertitel && (
                        <nldd-text size="xs" color="secondary">
                          {rij.discipline.ondertitel}
                        </nldd-text>
                      )}
                    </nldd-container>
                  </th>
                  {
                    fases.map((fase, index) => (
                      <RoadmapMatrixCel
                        class={index > 0 ? 'rr-matrix__cell--kolom-start' : undefined}
                        headers={`${swimlaneHeaderId(rij.laneId)} ${disciplineHeaderId(rij.discipline.id)} ${faseHeaderId(fase.id)}`}
                        cel={werkpakkettenInCel(
                          werkpakketten,
                          fase.id,
                          rij.discipline.id,
                        )}
                      />
                    ))
                  }
                </tr>
            ))
          }
        </tbody>
        </table>
      </div>
    </div>
  </RoadmapSectie>
</Base>

<script>
  import { GEEN_TREFFER } from '~/lib/roadmap-zoek';

  /*
   * De afhankelijkhedenweergave: waar een kaart komt te staan, en de pijlen
   * ertussen.
   *
   * Alles hier gebeurt in de browser, niets tijdens de build. Waar een kaart
   * hoort te staan hangt af van welke kaarten er op dat moment staan, en dat
   * bepalen de twee filters pas als er iemand typt of aanvinkt. Rekende de
   * build de inspringing uit, dan liet een weggefilterde kaart een gat in de
   * matrix achter en liep een keten door over kaarten die niet op het scherm
   * stonden.
   *
   * Zonder JavaScript gebeurt er niets: de schakelaar staat uit, de cellen
   * zijn een gewone stapel kaarten en de overlay blijft leeg.
   */

  /** Hoe lang de pijlpunt is, in dezelfde eenheid als de paden. */
  const PIJL_LENGTE = 11;
  const SVG_NS = 'http://www.w3.org/2000/svg';

  /**
   * De maten staan in roadmap.css op .rr-matrix en worden hier gelezen, niet
   * herhaald: de kolombreedte die dit script uitrekent en de opmaak die de
   * stylesheet aanbrengt moeten dezelfde getallen gebruiken.
   */
  function maten(table: HTMLElement) {
    const stijl = getComputedStyle(table);
    const px = (naam: string) => parseFloat(stijl.getPropertyValue(naam)) || 0;
    const kaart = px('--rr-kaart-breedte');
    const ruimte = px('--rr-pijl-ruimte');
    return { stap: kaart + ruimte, basis: kaart + (ruimte - px('--rr-matrix-gat')) };
  }

  type Plek = { kolom: number; rij: number };

  function wireAfhankelijkheden() {
    const canvas = document.querySelector<HTMLElement>('.rr-matrix-canvas');
    const svg = canvas?.querySelector<SVGSVGElement>('.rr-afhankelijk');
    const table = canvas?.querySelector<HTMLElement>('.rr-matrix');
    const schakelaar = document.getElementById('rr-afhankelijkheden');
    if (!canvas || !svg || !table || !schakelaar) return;

    const kaarten = Array.from(
      table.querySelectorAll<HTMLElement>('.rr-wp-card[data-wp-id]'),
    );
    if (!kaarten.length) return;

    const faseVolgorde = Array.from(
      table.querySelectorAll<HTMLElement>('thead th[id^="rr-fase-"]'),
    ).map((th) => th.id.slice('rr-fase-'.length));

    /*
     * `selected` en niet `checked`: de schakelaar is een nldd-toggle-button,
     * en die reflecteert zijn stand naar `selected`. De :has()-regels in
     * roadmap.css lezen hetzelfde attribuut — staan die twee niet op dezelfde
     * naam, dan tekent het script pijlen over een matrix die de CSS nooit in
     * de afhankelijkhedenstand heeft gezet, of andersom. Vandaar de controle
     * in assertFilterRules().
     */
    const aan = () => schakelaar.hasAttribute('selected');
    const { stap: STAP, basis: KOLOM_BASIS } = maten(table);

    /*
     * Op het scherm of niet. Het zoek- en beleggingsfilter verbergen met een
     * klasse en het categoriefilter met een :has()-regel, dus geen van drieën
     * is aan één attribuut af te lezen; de gerenderde hoogte vat ze alle drie
     * samen en kan niet uit de pas lopen met de CSS zoals een tweede kopie van
     * die logica in JS zou doen. Dat is dezelfde maat die de zoekteller
     * gebruikt.
     */
    const zichtbaar = (kaart: HTMLElement) => kaart.offsetHeight > 0;

    let buren = new Map<string, Set<string>>();

    /** Een pijl: `van` moet af zijn voordat `naar` kan beginnen. */
    let pijlen: { van: string; naar: string }[] = [];

    function indeel() {
      // Eerst alles terugzetten, zodat een uitgezette weergave en een
      // weggefilterde kaart geen plaatsing achterlaten die niemand meer beheert.
      for (const kaart of kaarten) {
        kaart.style.removeProperty('grid-column');
        kaart.style.removeProperty('grid-row');
      }
      table!.style.removeProperty('--rr-fase-kolommen');
      svg!.replaceChildren();
      buren = new Map();
      pijlen = [];
      if (!aan()) return;

      const zichtbare = kaarten.filter(zichtbaar);
      const ids = new Set(zichtbare.map((k) => k.dataset.wpId!));
      const fase = new Map(zichtbare.map((k) => [k.dataset.wpId!, k.dataset.fase!]));
      const voorwaarden = new Map(
        zichtbare.map((k) => [
          k.dataset.wpId!,
          (k.dataset.afhankelijkVan ?? '')
            .split(' ')
            .filter((v) => v && ids.has(v)),
        ]),
      );

      for (const [naar, van] of voorwaarden) {
        for (const v of van) pijlen.push({ van: v, naar });
      }
      for (const pijl of pijlen) {
        for (const [a, b] of [
          [pijl.van, pijl.naar],
          [pijl.naar, pijl.van],
        ]) {
          if (!buren.has(a)) buren.set(a, new Set());
          buren.get(a)!.add(b);
        }
      }

      /*
       * Hoe ver naar rechts: de langste keten van voorwaarden erachter binnen
       * dezelfde fase. Alleen dezelfde fase, want de matrix zet de fases al
       * links naar rechts; wie op iets uit een eerdere fase wacht staat er al
       * voorbij door in een latere kolom te staan.
       *
       * De kring die dit zou laten rondlopen is bij de build al afgevangen
       * (assertReferencesResolve); `bezig` is er zodat een kring die hier toch
       * komt één keer rondgaat in plaats van eeuwig.
       */
      const diepte = new Map<string, number>();
      const bezig = new Set<string>();
      const bereken = (id: string): number => {
        const bekend = diepte.get(id);
        if (bekend !== undefined) return bekend;
        if (bezig.has(id)) return 0;
        bezig.add(id);
        const eigen = (voorwaarden.get(id) ?? [])
          .filter((v) => fase.get(v) === fase.get(id))
          .map((v) => bereken(v) + 1);
        bezig.delete(id);
        const uitkomst = eigen.length ? Math.max(...eigen) : 0;
        diepte.set(id, uitkomst);
        return uitkomst;
      };
      for (const id of ids) bereken(id);

      /*
       * En hoe ver naar beneden: een kaart gaat op de rij van de voorwaarde
       * waar hij op wacht, zolang die plek vrij is, zodat een keten op één lijn
       * loopt en de pijlen recht zijn. Heeft hij in deze cel niets voor zich,
       * dan begint hij een eigen rij — twee werkpakketten staan zo alleen naast
       * elkaar als de een echt op de ander wacht. De DOM-volgorde binnen een cel
       * is `volgorde`, dus wie het eerst komt claimt de rij.
       */
      const cellen = new Map<HTMLElement, HTMLElement[]>();
      for (const kaart of zichtbare) {
        const cel = kaart.closest<HTMLElement>('.rr-cel-raster')!;
        if (!cellen.has(cel)) cellen.set(cel, []);
        cellen.get(cel)!.push(kaart);
      }

      for (const [, inCel] of cellen) {
        const bezetteRijen: Set<number>[] = [];
        const hier = new Map<string, Plek>();
        for (const kaart of inCel) {
          const id = kaart.dataset.wpId!;
          const kolom = diepte.get(id) ?? 0;
          const voorganger = (voorwaarden.get(id) ?? [])
            .map((v) => hier.get(v))
            .filter((plek): plek is Plek => plek !== undefined)
            .sort((a, b) => b.kolom - a.kolom)[0];
          const rij =
            voorganger !== undefined && !bezetteRijen[voorganger.rij]?.has(kolom)
              ? voorganger.rij
              : bezetteRijen.push(new Set()) - 1;
          bezetteRijen[rij].add(kolom);
          const plek = { kolom, rij };
          hier.set(id, plek);
          kaart.style.gridColumn = String(kolom + 1);
          kaart.style.gridRow = String(rij + 1);
        }
      }

      // Elke fasekolom zo breed als zijn diepste keten.
      table!.style.setProperty(
        '--rr-fase-kolommen',
        faseVolgorde
          .map((f) => {
            const diepst = zichtbare
              .filter((k) => k.dataset.fase === f)
              .reduce((m, k) => Math.max(m, diepte.get(k.dataset.wpId!) ?? 0), 0);
            return `minmax(${KOLOM_BASIS + diepst * STAP}px, 1fr)`;
          })
          .join(' '),
      );

      teken();
    }

    function doos(id: string) {
      const el = table!.querySelector<HTMLElement>(`[data-wp-id="${id}"]`);
      if (!el || !zichtbaar(el)) return null;
      const r = el.getBoundingClientRect();
      const c = canvas!.getBoundingClientRect();
      return {
        left: r.left - c.left,
        right: r.right - c.left,
        mid: r.top - c.top + r.height / 2,
      };
    }

    /*
     * De pijl verlaat de voorwaarde aan de kant die naar de wachtende kaart
     * wijst en komt daar aan de kant terug. Gespiegeld waar een latere fase
     * voorwaarde is voor een eerdere, want de andere route stuurt de kromme
     * dwars over de kaart waarop hij begint. Kaarten boven elkaar in dezelfde
     * kolom knopen allebei rechts aan en de kromme bolt ernaast uit.
     *
     * De kromme komt horizontaal aan, dus de lijn stopt één pijlpunt vóór de
     * kaart: anders loopt de streep onder de punt door en komt er aan de
     * voorkant weer uit.
     */
    function pad(
      van: NonNullable<ReturnType<typeof doos>>,
      naar: NonNullable<ReturnType<typeof doos>>,
    ) {
      const gestapeld = Math.abs(van.left - naar.left) < 8;
      const naarRechts = van.right <= naar.left;
      const x1 = gestapeld || naarRechts ? van.right : van.left;
      const x2 = gestapeld ? naar.right : naarRechts ? naar.left : naar.right;
      const bocht = gestapeld ? 64 : Math.max(48, Math.abs(x2 - x1) * 0.45);
      const richting = gestapeld || naarRechts ? 1 : -1;
      const eind = x2 - PIJL_LENGTE * (gestapeld ? 1 : richting);
      const c2 = eind + bocht * (gestapeld ? 1 : -richting);
      return `M ${x1} ${van.mid} C ${x1 + bocht * richting} ${van.mid}, ${c2} ${naar.mid}, ${eind} ${naar.mid}`;
    }

    function teken() {
      svg!.replaceChildren();
      // scrollWidth, niet offsetWidth: het grid is breder dan de scroller die
      // het afknipt, en een SVG op die maat snijdt elke pijl voorbij de vouw af.
      const breed = table!.scrollWidth;
      const hoog = table!.scrollHeight;
      svg!.setAttribute('width', String(breed));
      svg!.setAttribute('height', String(hoog));
      svg!.setAttribute('viewBox', `0 0 ${breed} ${hoog}`);

      const defs = document.createElementNS(SVG_NS, 'defs');
      const marker = document.createElementNS(SVG_NS, 'marker');
      marker.setAttribute('id', 'rr-pijlpunt');
      marker.setAttribute('viewBox', '0 0 10 8');
      // refX op de voet van de punt, zodat hij vóór het einde van de lijn staat
      // en zijn tip op de kaart landt. Op de tip zou hij precies het stuk
      // dekken waar de lijn nog loopt.
      marker.setAttribute('refX', '0');
      marker.setAttribute('refY', '4');
      marker.setAttribute('markerWidth', String(PIJL_LENGTE));
      marker.setAttribute('markerHeight', String(PIJL_LENGTE));
      marker.setAttribute('orient', 'auto-start-reverse');
      marker.setAttribute('markerUnits', 'userSpaceOnUse');
      const punt = document.createElementNS(SVG_NS, 'polygon');
      punt.setAttribute('points', '0,0 10,4 0,8');
      marker.appendChild(punt);
      defs.appendChild(marker);
      svg!.appendChild(defs);

      for (const pijl of pijlen) {
        const van = doos(pijl.van);
        const naar = doos(pijl.naar);
        if (!van || !naar) continue;
        const path = document.createElementNS(SVG_NS, 'path');
        path.setAttribute('d', pad(van, naar));
        path.setAttribute('class', 'rr-afhankelijk__lijn');
        path.setAttribute('marker-end', 'url(#rr-pijlpunt)');
        path.dataset.van = pijl.van;
        path.dataset.naar = pijl.naar;
        svg!.appendChild(path);
      }
    }

    /*
     * Wijs een kaart aan en de hele keten waar hij in zit blijft staan: alles
     * waar hij op wacht, alles wat op hem wacht, en zo door in beide
     * richtingen. De rest van de matrix valt terug, kaarten inbegrepen — de
     * pijlen alleen waren te weinig om als volgorde van werk te lezen, omdat
     * de kaarten ertussen even hard bleven staan.
     *
     * De keten loopt over `buren`, en daar staat alleen in wat zichtbaar is.
     * Een kaart die weggefilterd is geeft dus geen doorgang naar de volgende.
     */
    function keten(id: string): Set<string> {
      const gezien = new Set<string>([id]);
      const wachtrij = [id];
      while (wachtrij.length) {
        for (const buur of buren.get(wachtrij.pop()!) ?? []) {
          if (gezien.has(buur)) continue;
          gezien.add(buur);
          wachtrij.push(buur);
        }
      }
      return gezien;
    }

    function accent(id: string | null) {
      // Een kaart zonder afhankelijkheden heeft geen keten om te tonen, en de
      // rest van de matrix dimmen zou ruis zijn bij elke muisbeweging.
      const leden = id !== null && buren.has(id) ? keten(id) : null;
      canvas!.classList.toggle('rr-matrix-canvas--accent', leden !== null);
      for (const kaart of kaarten) {
        kaart.classList.toggle(
          'rr-wp-card--in-keten',
          leden !== null && leden.has(kaart.dataset.wpId!),
        );
      }
      for (const path of svg!.querySelectorAll<SVGPathElement>(
        '.rr-afhankelijk__lijn',
      )) {
        path.classList.toggle(
          'rr-afhankelijk__lijn--actief',
          leden !== null &&
            leden.has(path.dataset.van!) &&
            leden.has(path.dataset.naar!),
        );
      }
    }

    for (const kaart of kaarten) {
      const id = kaart.dataset.wpId!;
      kaart.addEventListener('pointerenter', () => accent(id));
      kaart.addEventListener('pointerleave', () => accent(null));
      kaart.addEventListener('focusin', () => accent(id));
      kaart.addEventListener('focusout', () => accent(null));
    }

    /*
     * Opnieuw indelen zodra er iets verandert aan wat er staat. Altijd een
     * frame later: nldd-checkbox-field stuurt zijn `change` terwijl `checked`
     * nog alleen een property is en Lit hem een microtask later naar het
     * attribuut spiegelt, en het is dat attribuut dat de :has()-regels lezen.
     * Meteen meten geeft dus de opmaak van vóór de klik. Dezelfde reden als bij
     * hertelStraks in RoadmapKop.astro.
     */
    let gepland = 0;
    const indeelStraks = () => {
      cancelAnimationFrame(gepland);
      gepland = requestAnimationFrame(indeel);
    };

    schakelaar.addEventListener('change', indeelStraks);
    for (const optie of document.querySelectorAll('.rr-filter__option')) {
      optie.addEventListener('change', indeelStraks);
    }
    /*
     * Het zoek- en het beleggingsfilter zijn een eigen script (in
     * RoadmapKop.astro) dat kaarten een klasse geeft; hier kijken we naar het
     * gevolg in plaats van naar de invoer, zodat ze niet aan elkaar vastzitten.
     *
     * Alleen naar de klassen die een kaart verbergen, en niet naar elke
     * klasse die er langskomt. Welke dat zijn staat niet hier maar op de
     * filtergroepen in de kop (data-verberg-klasse) en in lib/roadmap-zoek.ts
     * (GEEN_TREFFER), zodat een hernoeming daar niet stil dit script breekt.
     *
     * `accent()` zet bij hover `--in-keten` op de
     * kaarten van de keten, en die kaarten staan in deze tabel: een observer
     * op alles hertekent dan de SVG één frame na de hover, met
     * `replaceChildren()`, en wist zo precies de `--actief` die er net op
     * gezet was. De kaarten bleven wel oplichten, want die klassen raakt
     * indeel() niet aan — de pijl ertussen viel als enige weg.
     */
    const VERBERGERS = [
      GEEN_TREFFER,
      ...Array.from(
        document.querySelectorAll<HTMLElement>(
          '.rr-filtergroep[data-verberg-klasse]',
        ),
      ).map((el) => el.dataset.verbergKlasse!),
    ];
    new MutationObserver((mutaties) => {
      for (const mutatie of mutaties) {
        const el = mutatie.target as HTMLElement;
        const was = mutatie.oldValue ?? '';
        const nu = el.className ?? '';
        if (VERBERGERS.some((k) => was.includes(k) !== nu.includes(k))) {
          indeelStraks();
          return;
        }
      }
    }).observe(table, {
      subtree: true,
      attributes: true,
      attributeFilter: ['class'],
      attributeOldValue: true,
    });
    new ResizeObserver(indeelStraks).observe(table);

    indeel();
  }

  /*
   * Gebonden op astro:page-load en niet op het topniveau, om dezelfde reden als
   * het zoekscript in RoadmapKop.astro: bij een ClientRouter-navigatie terug
   * naar /roadmap is de DOM vers omgewisseld en zou een binding op het
   * topniveau niet meer draaien. Komt iemand van het bord of het overzicht,
   * dan vindt dit script geen matrix en stopt het op zijn guard.
   */
  document.addEventListener('astro:page-load', wireAfhankelijkheden);
</script>
