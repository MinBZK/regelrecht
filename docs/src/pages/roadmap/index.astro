---
/*
 * /roadmap — werkpakketten on a fase x discipline matrix.
 *
 * A read-only rendering of src/content/roadmap/; editing goes through a pull
 * request (every werkpakket page links to its own source on GitHub). The app
 * this came from could add, move and delete werkpakketten against a write API;
 * none of that survives here, because the site is a static build behind nginx.
 *
 * The matrix is a real <table>: fases are columns, disciplines are rows, and a
 * screen reader needs that relationship to place a card. CSS gives it back the
 * grid layout (see roadmap.css). Disciplines are further grouped into
 * swimlanes (roadmap-config.json), rendered as a narrow vertical bar to the
 * left of the row-header column, one per swimlane, spanning down over all of
 * its rows; see `matrixRijen` below.
 *
 * The five fases (Fase I..V) are the Wat/Wat/Hoe/Waar/Garantie maturity
 * staging; each fase's ondertitel names both that stage and its theme (e.g.
 * "Wat · Fundering en definitie"). An earlier version of this page also cut
 * the Wat-fase into its own nested time-subkolommen (nu/half-jaar/later-ooit)
 * — a second axis stacked inside the first, which read as two unrelated
 * dimensions in one matrix and was dropped; see the discussion on PR #1356.
 */
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import RoadmapMatrixCel from '~/components/RoadmapMatrixCel.astro';
import {
  fases,
  swimlanes,
  getDiscipline,
  FILTER_OPTIES,
  werkpakkettenInCel,
  assertReferencesResolve,
  assertFilterRules,
  type Discipline,
} from '~/lib/roadmap';
import '~/styles/roadmap.css';
// The stylesheet's own text, so the filter check below can read the rules it
// is about. ?raw gives the source; the ordinary import above is what ships.
import roadmapCss from '~/styles/roadmap.css?raw';

const werkpakketten = await getCollection('werkpakketten');
// Fails the build on a faseId, disciplineId or samenhangId that goes nowhere.
// check-links.mjs cannot see these: they end up on NLDD component attributes,
// not on <a href>.
assertReferencesResolve(werkpakketten);
// Fails the build when a filter option has no rule to show its cards again.
assertFilterRules(roadmapCss);

/*
 * One row per discipline, grouped under its swimlane —
 * assertSwimlanesMatchDisciplines() (lib/roadmap.ts) guarantees every
 * discipline is in exactly one, so this partitions all of them without
 * dropping or duplicating a row. The first row of each swimlane carries
 * `bar`: the swimlane's name plus how many rows (including its own) belong
 * to it, so the template can draw one vertical cell there spanning down —
 * the same rowspan-via-inline-grid-style technique the header uses for its
 * fase columns. Every later row of that swimlane leaves `bar` undefined; the
 * grid's own auto-placement skips the column there, the same way it already
 * skips columns under a rowspan header.
 *
 * `bar.zichtbaar` is false when a swimlane has exactly one discipline whose
 * name is identical to the swimlane's own — "Transitie-ondersteuning" and
 * "Samenwerking met andere initiatieven" both name themselves twice today.
 * The vertical bar and the row-header would then print the same word twice,
 * once sideways, right next to each other. The `<th>` still renders (the
 * accessible name stays, and the coloured/bordered bar keeps running the
 * full height of the matrix, uninterrupted), only its text is visually
 * hidden — `.rr-sr-only` in roadmap.css. Give the discipline a name distinct
 * from its swimlane's and both show.
 */
interface MatrixRow {
  discipline: Discipline;
  label: string;
  laneId: string;
  bar?: { naam: string; rowspan: number; zichtbaar: boolean };
}
const matrixRijen: MatrixRow[] = swimlanes.flatMap((lane) => {
  const laneDisciplines = lane.disciplineIds.map((id) => getDiscipline(id)!);
  return laneDisciplines.map((discipline, index) => ({
    discipline,
    label: discipline.naam,
    laneId: lane.id,
    bar:
      index === 0
        ? {
            naam: lane.naam,
            rowspan: laneDisciplines.length,
            zichtbaar: !(
              laneDisciplines.length === 1 && lane.naam === discipline.naam
            ),
          }
        : undefined,
  }));
});

// Ids for the `headers` attribute below: with two levels of row header (the
// swimlane bar spans several rows, the discipline header one), a screen
// reader can no longer infer the association from `scope` alone — pa11y's
// htmlcs runner flags exactly that ("multiple levels of th elements"). Every
// <td> names all three headers that apply to it explicitly instead.
const faseHeaderId = (faseId: string) => `rr-fase-${faseId}`;
const disciplineHeaderId = (disciplineId: string) => `rr-discipline-${disciplineId}`;
const swimlaneHeaderId = (laneId: string) => `rr-swimlane-${laneId}`;

const pathname = '/roadmap';
---

<Base
  lang="nl"
  kind="docs"
  pathname={pathname}
  noSearchIndex
  title="Roadmap · RegelRecht"
  description="Werkpakketten van RegelRecht, geordend per fase en discipline."
>
  {/*
    Two measures on one page. `width="full"` drops the section's body
    max-width, which every other docs page keeps for a readable line length;
    the matrix needs that, because it is seven columns wide and would
    otherwise scroll horizontally inside a measure meant for paragraphs.

    Only the matrix. The heading and the filter keep the docs measure and stay
    where they sit on every other page: .rr-roadmap__kop (roadmap.css) puts
    the token back and centres them, so they line up with the navigation bar
    above and the footer below, and the table alone breaks out of that column.
    The section's own inline padding stays either way, so the table keeps a
    gutter to the viewport edge.
  */}
  <nldd-simple-section
    width="full"
    sm-padding-bottom="32"
    md-padding-bottom="64"
    lg-padding-bottom="96"
  >
    <nldd-container class="rr-roadmap" gap="24">
      <nldd-container class="rr-roadmap__kop" gap="24">
        <nldd-title size="1">
          <h1>Roadmap</h1>
          <p slot="subtitle">
            Werkpakketten per fase en discipline. Deze weergave is read-only;
            wijzigen gaat via een pull request op GitHub.
          </p>
        </nldd-title>

        {/*
          The categorie filter works without any JavaScript of our own:
          nldd-checkbox-field reflects `checked` onto its host element, so the
          :has() rules in roadmap.css can read the state straight off the
          component. A <fieldset> and <legend> group the controls, which is
          what a group of checkboxes needs and what the design system has no
          component for.

          It composes with the zoekfilter above rather than overriding it: a
          card shows when both allow it. The specificity that makes that hold
          is spelled out in roadmap.css.
        */}
        {/*
          The zoekfilter. Unlike the categorie filter below it this one needs a
          script: CSS cannot compare a typed string to a card's text. It is
          progressive — with no JavaScript the field never appears (the script
          unhides it), so a dead input is never shown.

          `rr-zoek-count` is the live region that says how much is left; it is
          the only feedback that a search which matches nothing did anything,
          since an empty matrix on its own reads as a broken page.
        */}
        <nldd-container class="rr-zoek" gap="8" hidden>
          {/*
            `width` is the component's own attribute, so the cap needs no CSS
            of ours. It pairs with the component's max-width:100%, so the field
            still shrinks below this on a narrow screen instead of overflowing.
            Left to stretch, it would run the full docs measure and read as a
            field for a paragraph rather than for a couple of words.
          */}
          <nldd-search-field
            id="rr-zoek-veld"
            placeholder="Zoek in werkpakketten"
            accessible-label="Zoek in werkpakketten"
            width="420px"
            no-spellcheck
          ></nldd-search-field>
          <nldd-text
            id="rr-zoek-count"
            size="sm"
            color="secondary"
            role="status"
            aria-live="polite"
          ></nldd-text>
        </nldd-container>

        <fieldset class="rr-filter">
          <legend class="rr-filter__legend">
            <nldd-text size="sm" weight="medium" color="secondary">
              Filter op categorie
            </nldd-text>
          </legend>
          {
            FILTER_OPTIES.map((optie) => (
              <nldd-checkbox-field
                class="rr-filter__option"
                id={`rr-cat-${optie.id}`}
                label={optie.label}
              />
            ))
          }
        </fieldset>
      </nldd-container>

      {/* tabindex + role make the horizontally scrolling matrix reachable by
          keyboard; without it axe flags scrollable-region-focusable. */}
      <div
        class="rr-matrix-scroll"
        tabindex="0"
        role="region"
        aria-label="Roadmapmatrix, horizontaal scrollbaar"
      >
        <table class="rr-matrix" style={`--rr-fase-count: ${fases.length}`}>
          <caption class="rr-matrix__caption">
            Werkpakketten per fase (kolommen) en discipline (rijen). De vijf
            fases zijn Wat (in twee stappen), Hoe, Waar en Garantie. De
            disciplines zijn gegroepeerd in vier swimlanes: Scope RegelRecht,
            Onderzoek, Samenwerking met andere initiatieven, en
            Transitie-ondersteuning.
          </caption>
          <thead>
            {/* Corner spans both the swimlane-bar column and the row-header
                column, so the fase headers start at the same column as the
                cards below them. */}
            <tr>
              <td
                class="rr-matrix__corner"
                colspan={2}
                style="grid-column: span 2"
              ></td>
              {
                fases.map((fase) => (
                  <th
                    scope="col"
                    id={faseHeaderId(fase.id)}
                    class="rr-matrix__header rr-matrix__header--fase"
                  >
                    <nldd-container gap="4" horizontal-alignment="center">
                      <nldd-text size="md" weight="bold">{fase.naam}</nldd-text>
                      {fase.ondertitel && (
                        <nldd-text size="xs" color="secondary">
                          {fase.ondertitel}
                        </nldd-text>
                      )}
                    </nldd-container>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              matrixRijen.map((rij) => (
                  <tr>
                    {rij.bar && (
                      <th
                        scope="rowgroup"
                        id={swimlaneHeaderId(rij.laneId)}
                        rowspan={rij.bar.rowspan}
                        style={`grid-row: span ${rij.bar.rowspan}`}
                        class="rr-matrix__header rr-matrix__header--swimlanebalk"
                      >
                        <nldd-text
                          size="sm"
                          weight="bold"
                          class={rij.bar.zichtbaar ? undefined : 'rr-sr-only'}
                        >
                          {rij.bar.naam}
                        </nldd-text>
                      </th>
                    )}
                    <th
                      scope="row"
                      id={disciplineHeaderId(rij.discipline.id)}
                      class="rr-matrix__header rr-matrix__header--discipline"
                    >
                      <nldd-container gap="4">
                        <nldd-text size="md" weight="bold">{rij.label}</nldd-text>
                        {rij.discipline.ondertitel && (
                          <nldd-text size="xs" color="secondary">
                            {rij.discipline.ondertitel}
                          </nldd-text>
                        )}
                      </nldd-container>
                    </th>
                    {
                      fases.map((fase, index) => (
                        <RoadmapMatrixCel
                          class={index > 0 ? 'rr-matrix__cell--kolom-start' : undefined}
                          headers={`${swimlaneHeaderId(rij.laneId)} ${disciplineHeaderId(rij.discipline.id)} ${faseHeaderId(fase.id)}`}
                          cel={werkpakkettenInCel(
                            werkpakketten,
                            fase.id,
                            rij.discipline.id,
                          )}
                        />
                      ))
                    }
                  </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </nldd-container>
  </nldd-simple-section>
</Base>

{/*
  The zoekfilter.

  A module script, so it is bundled and `normaliseerZoekterm` is the very
  function the build used to write every `data-zoek` — the two sides of a
  search have to normalise identically, and importing it is the only way to
  keep that true without a second copy drifting. It comes from
  lib/roadmap-zoek.ts rather than lib/roadmap.ts for a hard reason: the latter
  imports astro:content and node:fs, which a client bundle cannot have.

  It matches on all terms, in any order: "garantie toezicht" finds a card that
  has both words anywhere in its text, not the phrase. That is what someone
  typing two words means, and it makes the field forgiving about the order the
  words happen to appear in.

  Hiding is a class on the card, not `display` set inline: the categorie filter
  already owns `display` through its :has() rules, and a script writing
  element.style would beat those and strand a card visible that the categorie
  filter had hidden. As a class the two compose — a card shows only when both
  filters allow it, which is what a reader expects of two controls side by side.
*/}
<script>
  import { normaliseerZoekterm } from '~/lib/roadmap-zoek';

  function wireZoek() {
    const field = document.getElementById('rr-zoek-veld');
    const count = document.getElementById('rr-zoek-count');
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>('.rr-wp-card[data-zoek]'),
    );
    if (!field || !count || !cards.length) return;

    // The field is hidden in the markup so it never shows without this script
    // behind it. `hidden` sits on the wrapper, which also holds the counter.
    field.closest<HTMLElement>('.rr-zoek')?.removeAttribute('hidden');

    const filter = (raw: string) => {
      const terms = normaliseerZoekterm(raw).split(' ').filter(Boolean);

      for (const card of cards) {
        const haystack = card.dataset.zoek ?? '';
        const match = terms.every((term) => haystack.includes(term));
        card.classList.toggle('rr-wp-card--geen-treffer', !match);
      }

      /*
       * Count what is actually on screen, not what the search matched.
       *
       * The categorie filter hides cards through its own CSS, which this
       * script knows nothing about, so counting search matches would state a
       * number the reader cannot see — and with a categorie checked and a
       * query typed it could announce "1 van de 49 gevonden" over an empty
       * matrix. Asking the browser for the rendered height settles it against
       * both filters at once and cannot drift from the CSS the way a second
       * copy of the categorie logic in JS would.
       *
       * Read after the loop above, so the class changes are already applied.
       */
      const zichtbaar = cards.filter((card) => card.offsetHeight > 0).length;

      // Silent while the field is empty: with nothing typed the count would
      // state the obvious on every page load and read as a result.
      if (!terms.length) {
        count.textContent = '';
      } else if (zichtbaar === 0) {
        count.textContent = 'Geen werkpakketten gevonden.';
      } else {
        // "werkpakketten" stays plural whatever the count: the noun in this
        // sentence belongs to the total, not to the hits. "1 van de 49
        // werkpakket" is what agreeing with the hit count produces.
        count.textContent = `${zichtbaar} van de ${cards.length} werkpakketten gevonden.`;
      }
    };

    // `input` covers typing and the component's own clear button; `search`
    // fires on Enter, where the value is already the same, so re-running is
    // harmless and keeps the two paths from needing different code.
    for (const event of ['input', 'search']) {
      field.addEventListener(event, (e) => {
        filter((e as CustomEvent<{ value: string }>).detail?.value ?? '');
      });
    }

    // The categorie checkboxes change what is on screen without the query
    // changing, so the count has to be recomputed from their state too —
    // otherwise it keeps reporting the tally from the last keystroke.
    for (const optie of document.querySelectorAll('.rr-filter__option')) {
      optie.addEventListener('change', () => filter(fieldValue(field)));
    }
  }

  /** The field's current text, via the property the component reflects. */
  function fieldValue(field: HTMLElement): string {
    return (field as HTMLElement & { value?: string }).value ?? '';
  }

  /*
   * Bound on astro:page-load, not at top level. Base.astro renders
   * <ClientRouter />, and a module script runs once per document: on a
   * ClientRouter navigation back to /roadmap the DOM is swapped in fresh —
   * `hidden` back on the wrapper, no listeners — and a top-level binding would
   * never run again, leaving no search field at all until a hard reload. Since
   * every card links to a detail page, that return trip is the normal path
   * through this page. astro:page-load also fires on the initial load, so this
   * covers both. Same pattern as wireSearch() in Base.astro.
   */
  document.addEventListener('astro:page-load', wireZoek);
</script>
