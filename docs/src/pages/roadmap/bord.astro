---
/*
 * /roadmap/bord — dezelfde werkpakketten als de matrix, als brede rijen
 * onder elkaar, elk uit te klappen tot de onderzoeksvragen die erin staan.
 *
 * Waar de matrix laat zien wát er te doen is (per fase en discipline), laat
 * het bord per werkpakket zien hoe ver de vragen erin zijn. Druk op een rij
 * en de vragen schuiven eronder uit, elk met zijn stand: vrij, opgepakt of
 * klaar, uit de eigen status van de vraag of anders uit de belegging van het
 * werkpakket (vraagLane() in lib/roadmap.ts).
 *
 * Geen lanes, met opzet: de belegging is hier een filter naast categorie,
 * net als op de matrix, en de rij houdt zijn volle breedte zodat de vragen
 * eronder leesbaar zijn. Geen afhankelijkhedenschakelaar: die ordent kaarten
 * binnen een cel van de matrix, en hier is geen cel.
 *
 * Een nldd-list van het type `tree` met RoadmapWerkpakketRij.astro per
 * werkpakket; het ontwerpsysteem regelt de pijltoetsen, aria-expanded en het
 * tonen van de kinderen op `expanded`. Wat het niet doet is `expanded`
 * omzetten bij een klik op de rij: die stand is van de pagina, en het script
 * onderaan zet hem. Geen eigen CSS.
 */
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import RoadmapSectie from '~/components/RoadmapSectie.astro';
import RoadmapKop from '~/components/RoadmapKop.astro';
import RoadmapWerkpakketRij from '~/components/RoadmapWerkpakketRij.astro';
import {
  werkpakketVolgorde,
  assertReferencesResolve,
  assertBelegging,
  assertFilterRules,
} from '~/lib/roadmap';
import '~/styles/roadmap.css';
// De tekst van de stylesheet, voor assertFilterRules(); zie index.astro.
import roadmapCss from '~/styles/roadmap.css?raw';

const werkpakketten = await getCollection('werkpakketten');
assertReferencesResolve(werkpakketten);
assertBelegging(werkpakketten);
assertFilterRules(roadmapCss);

// In de leesvolgorde van de matrix, zodat wie van de ene weergave naar de
// andere gaat de werkpakketten op dezelfde plek terugvindt.
const rijen = [...werkpakketten].sort((a, b) => werkpakketVolgorde(a.data, b.data));

const pathname = '/roadmap/bord';
---

<Base
  lang="nl"
  kind="docs"
  pathname={pathname}
  noSearchIndex
  title="Bord · Roadmap · RegelRecht"
  description="Werkpakketten van RegelRecht met per werkpakket de stand van zijn onderzoeksvragen."
>
  <RoadmapSectie>
    <RoadmapKop
      huidig="bord"
      ondertitel="Werkpakketten onder elkaar. Druk op een werkpakket en zijn onderzoeksvragen schuiven eruit, elk met de stand: vrij, opgepakt of klaar."
      zoek={{ placeholder: 'Zoek in werkpakketten', noun: 'werkpakketten' }}
      filters={['categorie', 'belegging']}
    />

    <nldd-list type="tree" appearance="box-tinted" accessible-label="Werkpakketten met hun onderzoeksvragen">
      {rijen.map((wp) => <RoadmapWerkpakketRij wp={wp} />)}
    </nldd-list>
  </RoadmapSectie>
</Base>

{/*
  Een klik op een werkpakketrij klapt zijn vragen uit of in. Alleen de rij
  zelf: een klik in een uitgeklapte vraag bubbelt naar de ouder en zou hem
  anders weer dichtklappen. Gebonden op astro:page-load, om dezelfde reden als
  het zoekscript in RoadmapKop.astro.
*/}
<script>
  function wireUitklappen() {
    for (const rij of document.querySelectorAll<HTMLElement>(
      '.rr-roadmap nldd-list-item[button][data-wp-id]',
    )) {
      rij.addEventListener('click', (event) => {
        const bron = (event.target as HTMLElement).closest('nldd-list-item');
        if (bron !== rij) return;
        rij.toggleAttribute('expanded');
      });
    }
  }

  document.addEventListener('astro:page-load', wireUitklappen);
</script>
