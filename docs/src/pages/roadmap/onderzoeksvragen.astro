---
/*
 * /roadmap/onderzoeksvragen — alle onderzoeksvragen van de roadmap als
 * kaarten op een bord, in dezelfde drie lanes als het werkpakkettenbord:
 * vrij, opgepakt, klaar.
 *
 * Een vraag staat in de lane van zijn eigen status (open, loopt, beantwoord),
 * en zonder eigen status in de lane van de belegging van zijn werkpakket; zie
 * vraagLane() in lib/roadmap.ts. De kaart zegt welke van de twee het was.
 * Elke kaart linkt naar de vraag op zijn werkpakketpagina, waar het doel, de
 * deelvragen en de verwante vragen voluit staan.
 *
 * Dezelfde opbouw als bord.astro, met opzet: wie het ene bord kent, kent het
 * andere. Geen statusfilter, want de lanes zíjn de status; wel zoeken, over de
 * vraag, het doel, de deelvragen, het werkpakket en de papersectie.
 */
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import RoadmapSectie from '~/components/RoadmapSectie.astro';
import RoadmapKop from '~/components/RoadmapKop.astro';
import RoadmapVraagKaart from '~/components/RoadmapVraagKaart.astro';
import {
  VRAGEN_LANES,
  vragenPerLane,
  telStatussen,
  ONDERZOEK_STANDEN,
  GEEN_STATUS,
  assertReferencesResolve,
  assertPaperSections,
  assertOnderzoeksvragen,
  assertFilterRules,
} from '~/lib/roadmap';
import '~/styles/roadmap.css';
// De tekst van de stylesheet, voor assertFilterRules(); zie index.astro.
import roadmapCss from '~/styles/roadmap.css?raw';

const werkpakketten = await getCollection('werkpakketten');
assertReferencesResolve(werkpakketten);
assertPaperSections(werkpakketten);
assertOnderzoeksvragen(werkpakketten);
assertFilterRules(roadmapCss);

const perLane = vragenPerLane(werkpakketten);
const lanes = VRAGEN_LANES.map((lane) => ({
  ...lane,
  kaarten: perLane.get(lane.id) ?? [],
}));
const telling = telStatussen(werkpakketten);

// "14 open, 10 loopt, 0 beantwoord, 25 niet bepaald", in de volgorde van de
// standen; een stand zonder treffers staat er als 0.
const standenTekst = (per: Record<string, number>) =>
  [
    ...ONDERZOEK_STANDEN.map((s) => `${per[s.id] ?? 0} ${s.label.toLowerCase()}`),
    `${per[GEEN_STATUS] ?? 0} niet bepaald`,
  ].join(', ');

const meervoud = (n: number, een: string, meer: string) =>
  `${n} ${n === 1 ? een : meer}`;

const pathname = '/roadmap/onderzoeksvragen';
---

<Base
  lang="nl"
  kind="docs"
  pathname={pathname}
  noSearchIndex
  title="Onderzoeksvragen · Roadmap · RegelRecht"
  description="Alle onderzoeksvragen van de RegelRecht-roadmap op een bord: vrij, opgepakt en beantwoord."
>
  <RoadmapSectie>
    <RoadmapKop
      huidig="onderzoeksvragen"
      ondertitel="Alle onderzoeksvragen van de werkpakketten op een bord: wat open ligt, waar iemand aan werkt, en wat beantwoord is. Een vraag volgt zijn eigen status, en anders de belegging van zijn werkpakket."
      zoek={{ placeholder: 'Zoek in onderzoeksvragen', noun: 'vragen' }}
      filters={[]}
    />

    {/*
      Twee regels tellingen, niet één: de eerste gaat over de vragen zelf
      (eigen status), de tweede over hun werkpakketten. Ze lopen uiteen, en
      dat is precies wat dit bord zichtbaar wil maken.
    */}
    <nldd-container gap="4">
      <nldd-text size="sm">
        {meervoud(telling.vragen.totaal, 'vraag', 'vragen')}, eigen status:{' '}
        {standenTekst(telling.vragen.perStatus)}.
        {telling.deelvragen.totaal > 0 &&
          ` Daaronder ${meervoud(telling.deelvragen.totaal, 'deelvraag', 'deelvragen')}, ${telling.deelvragen.beantwoord} beantwoord.`}
      </nldd-text>
      <nldd-text size="sm" color="secondary">
        Onderzoek per werkpakket ({telling.werkpakketten.totaal} werkpakketten):{' '}
        {standenTekst(telling.werkpakketten.perStatus)}.
      </nldd-text>
    </nldd-container>

    {/* Zelfde lanes als bord.astro; de telling in de kop is de stand bij de
        build, het zoekveld meldt zelf hoeveel er na het zoeken over is. */}
    <nldd-container layout="grid" column-count="3" sm-column-count="1" gap="16">
      {
        lanes.map((lane) => (
          <nldd-box background="tinted">
            <nldd-container padding="12" gap="12">
              <nldd-container gap="2">
                <nldd-title size="5">
                  <h2>{lane.label}</h2>
                </nldd-title>
                <nldd-text size="sm" color="secondary">
                  {meervoud(lane.kaarten.length, 'vraag', 'vragen')}
                </nldd-text>
              </nldd-container>
              {lane.kaarten.length ? (
                <nldd-container gap="8">
                  {lane.kaarten.map(({ vraag, werkpakket }) => (
                    <RoadmapVraagKaart vraag={vraag} werkpakket={werkpakket} />
                  ))}
                </nldd-container>
              ) : (
                <nldd-text size="sm" color="secondary">
                  {lane.leeg}
                </nldd-text>
              )}
            </nldd-container>
          </nldd-box>
        ))
      }
    </nldd-container>
  </RoadmapSectie>
</Base>
