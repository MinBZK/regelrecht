---
/*
 * /roadmap/onderzoeksvragen — de paragrafen van het position paper als
 * tegels, elk uit te klappen tot de onderzoeksvragen die eraan hangen, en
 * elke vraag weer tot een mini-kanbanbord met zijn deelvragen.
 *
 * Een vraag heeft een stand zoals een werkpakket een belegging heeft: zijn
 * eigen status (open is vrij, loopt is opgepakt, beantwoord is klaar), en
 * zonder eigen status die van de belegging van zijn werkpakket; zie
 * vraagLane() in lib/roadmap.ts. Een deelvraag volgt op dezelfde manier zijn
 * vraag (deelvraagLane()). De paragraaftegel telt zijn vragen per stand.
 *
 * Het filter op stand en het zoekveld werken op de vragen; een paragraaf
 * waarvan niets overblijft verdwijnt mee. Dezelfde tegels en hetzelfde
 * uitklappen als het bord (nldd-list type tree, RoadmapUitklap).
 *
 * De schakelaar "Per paragraaf" (standaard aan) zet de paragraaftegels uit
 * en toont de vragen als één vlakke lijst in dezelfde volgorde. Niet twee
 * keer dezelfde tegels in de DOM: het script onderaan verhuist de
 * vraagtegels tussen hun paragraaf en de vlakke lijst, met hun uitklapstand
 * en al, en de zoekteller telt elke vraag zo maar één keer.
 */
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import RoadmapSectie from '~/components/RoadmapSectie.astro';
import RoadmapKop from '~/components/RoadmapKop.astro';
import RoadmapParagraafRij from '~/components/RoadmapParagraafRij.astro';
import RoadmapUitklap from '~/components/RoadmapUitklap.astro';
import RoadmapWerkpakketPaneel from '~/components/RoadmapWerkpakketPaneel.astro';
import {
  vragenOpVolgorde,
  verwantIndex,
  telStatussen,
  ONDERZOEK_STANDEN,
  GEEN_STATUS,
  assertReferencesResolve,
  assertPaperSections,
  assertOnderzoeksvragen,
  assertFilterRules,
  type PaperSectie,
} from '~/lib/roadmap';
import '~/styles/roadmap.css';
// De tekst van de stylesheet, voor assertFilterRules(); zie index.astro.
import roadmapCss from '~/styles/roadmap.css?raw';

const werkpakketten = await getCollection('werkpakketten');
assertReferencesResolve(werkpakketten);
assertPaperSections(werkpakketten);
assertOnderzoeksvragen(werkpakketten);
assertFilterRules(roadmapCss);

const meervoud = (n: number, een: string, meer: string) =>
  `${n} ${n === 1 ? een : meer}`;

const vragen = vragenOpVolgorde(werkpakketten);
const verwanten = verwantIndex(werkpakketten);
const telling = telStatussen(werkpakketten);

/*
 * De vragen per paragraaf van het paper, in de volgorde waarin ze al staan.
 * Elke paragraaf wordt een tegel met zijn vragen eronder; wat geen paragraaf
 * heeft komt als laatste tegel, "Zonder sectie in het paper".
 */
const paragrafen: { sectie?: PaperSectie; items: typeof vragen }[] = [];
for (const item of vragen) {
  const laatste = paragrafen.at(-1);
  if (laatste && laatste.sectie?.slug === item.vraag.paper?.slug) {
    laatste.items.push(item);
  } else {
    paragrafen.push({ sectie: item.vraag.paper, items: [item] });
  }
}

// "14 open, 10 loopt, 0 beantwoord, 25 niet bepaald", in de volgorde van de
// standen; een stand zonder treffers staat er als 0.
const standenTekst = (per: Record<string, number>) =>
  [
    ...ONDERZOEK_STANDEN.map((s) => `${per[s.id] ?? 0} ${s.label.toLowerCase()}`),
    `${per[GEEN_STATUS] ?? 0} niet bepaald`,
  ].join(', ');

const pathname = '/roadmap/onderzoeksvragen';
---

<Base
  lang="nl"
  kind="docs"
  pathname={pathname}
  noSearchIndex
  title="Onderzoeksvragen · Roadmap · RegelRecht"
  description="Alle onderzoeksvragen van de RegelRecht-roadmap, met hun stand, deelvragen en verwante vragen."
>
  <RoadmapSectie>
    <RoadmapKop
      huidig="onderzoeksvragen"
      ondertitel="De paragrafen van het position paper, elk met de onderzoeksvragen die eraan hangen. Druk op een paragraaf voor zijn vragen, en op een vraag voor zijn deelvragen, elk met de stand: vrij, opgepakt of klaar."
      zoek={{ placeholder: 'Zoek in onderzoeksvragen', noun: 'vragen' }}
      filters={['stand']}
      weergaven={[
        {
          id: 'paragrafen',
          text: 'Per paragraaf',
          icon: 'list',
          accessibleLabel: 'Vragen per paragraaf van het paper tonen',
          aan: true,
        },
      ]}
    />

    {/*
      Twee regels tellingen, niet één: de eerste gaat over de vragen zelf
      (eigen status), de tweede over hun werkpakketten. Ze lopen uiteen, en
      dat is precies wat deze pagina zichtbaar wil maken.
    */}
    <nldd-container gap="4">
      <nldd-text size="sm">
        {meervoud(telling.vragen.totaal, 'vraag', 'vragen')}, eigen status:{' '}
        {standenTekst(telling.vragen.perStatus)}.
        {telling.deelvragen.totaal > 0 &&
          ` Daaronder ${meervoud(telling.deelvragen.totaal, 'deelvraag', 'deelvragen')}, ${telling.deelvragen.beantwoord} beantwoord.`}
      </nldd-text>
      <nldd-text size="sm" color="secondary">
        Onderzoek per werkpakket ({telling.werkpakketten.totaal} werkpakketten):{' '}
        {standenTekst(telling.werkpakketten.perStatus)}.
      </nldd-text>
    </nldd-container>

    {/* Eén kolom, de volle breedte: per paragraaf een tegel, dicht bij het
        laden; een druk erop laat de vragen eronder vallen, elk weer een tegel
        die uitklapt tot zijn deelvragen. Een paragraaf waarvan het zoeken of
        het standfilter alle vragen weghaalt verdwijnt mee (roadmap.css). */}
    <nldd-container gap="8" data-paragrafen>
      {
        paragrafen.map((p) => (
          <RoadmapParagraafRij sectie={p.sectie} items={p.items} verwanten={verwanten} />
        ))
      }
    </nldd-container>
    {/* De vlakke lijst: leeg bij de build, gevuld door het script als de
        schakelaar uitgaat. Eén set tegels, die verhuist. */}
    <nldd-container gap="8" data-vlak hidden></nldd-container>
  </RoadmapSectie>
  <RoadmapUitklap />
  <RoadmapWerkpakketPaneel werkpakketten={werkpakketten} />
</Base>

{/*
  De schakelaar "Per paragraaf". Uit: elke vraagtegel verhuist, in volgorde,
  naar de vlakke lijst; de paragraaftegels zijn dan leeg en verdwijnen via de
  :has()-regel in roadmap.css. Aan: elke tegel gaat terug naar de paragraaf
  die hij op `data-paragraaf` draagt. Verhuizen in plaats van kopiëren houdt
  de uitklapstand van een tegel en laat de zoekteller kloppen.
*/}
<script>
  function wireParagrafen() {
    const schakelaar = document.getElementById('rr-paragrafen');
    const vlak = document.querySelector<HTMLElement>('[data-vlak]');
    const paragrafen = document.querySelector<HTMLElement>('[data-paragrafen]');
    if (!schakelaar || !vlak || !paragrafen) return;

    const indeel = () => {
      const aan = schakelaar.hasAttribute('selected');
      const tegels = Array.from(
        document.querySelectorAll<HTMLElement>('nldd-list[data-paragraaf]'),
      );
      if (aan) {
        for (const tegel of tegels) {
          document
            .querySelector(`[data-paragraaf-vragen="${tegel.dataset.paragraaf}"]`)
            ?.appendChild(tegel);
        }
      } else {
        for (const tegel of tegels) vlak.appendChild(tegel);
      }
      vlak.hidden = aan;
      paragrafen.hidden = !aan;
    };

    schakelaar.addEventListener('change', () =>
      requestAnimationFrame(indeel),
    );
    // Ook één keer bij het laden: de knop is form-associated, en een browser
    // kan zijn stand herstellen bij een terugnavigatie terwijl de tegels nog
    // in de build-stand staan.
    indeel();
  }

  document.addEventListener('astro:page-load', wireParagrafen);
</script>
