---
/*
 * /roadmap/onderzoeksvragen — alle onderzoeksvragen van de roadmap als
 * kaarten, met een filter op hun stand (vrij, opgepakt, klaar) en een
 * zijpaneel dat opent als je op een kaart drukt.
 *
 * Een vraag heeft een stand zoals een werkpakket een belegging heeft: zijn
 * eigen status (open is vrij, loopt is opgepakt, beantwoord is klaar), en
 * zonder eigen status die van de belegging van zijn werkpakket; zie
 * vraagLane() in lib/roadmap.ts. De kaart zegt welke van de twee het was.
 *
 * Geen lanes, met opzet: de vragen zijn te veel en te ongelijk verdeeld voor
 * drie kolommen, en de vraag die iemand hier heeft is "welke staan open" of
 * "waar wordt aan gewerkt". Dat is een filter, hetzelfde als het
 * beleggingsfilter op de matrix.
 *
 * Drukken op een kaart gaat niet naar de werkpakketpagina maar opent een
 * nldd-sheet aan de rechterkant met het doel, de deelvragen en de verwante
 * vragen. Alle panelen staan bij de build in de DOM, verborgen; het script
 * hieronder toont er één. Op een smal scherm wordt de sheet vanzelf een
 * paneel van onderen. De werkpakketpagina blijft één link verder.
 */
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import RoadmapSectie from '~/components/RoadmapSectie.astro';
import RoadmapKop from '~/components/RoadmapKop.astro';
import RoadmapVraagKaart from '~/components/RoadmapVraagKaart.astro';
import RoadmapVraagDetail from '~/components/RoadmapVraagDetail.astro';
import {
  vragenOpVolgorde,
  verwantIndex,
  telStatussen,
  ONDERZOEK_STANDEN,
  GEEN_STATUS,
  assertReferencesResolve,
  assertPaperSections,
  assertOnderzoeksvragen,
  assertFilterRules,
} from '~/lib/roadmap';
import '~/styles/roadmap.css';
// De tekst van de stylesheet, voor assertFilterRules(); zie index.astro.
import roadmapCss from '~/styles/roadmap.css?raw';

const werkpakketten = await getCollection('werkpakketten');
assertReferencesResolve(werkpakketten);
assertPaperSections(werkpakketten);
assertOnderzoeksvragen(werkpakketten);
assertFilterRules(roadmapCss);

const vragen = vragenOpVolgorde(werkpakketten);
const verwanten = verwantIndex(werkpakketten);
const telling = telStatussen(werkpakketten);

// "14 open, 10 loopt, 0 beantwoord, 25 niet bepaald", in de volgorde van de
// standen; een stand zonder treffers staat er als 0.
const standenTekst = (per: Record<string, number>) =>
  [
    ...ONDERZOEK_STANDEN.map((s) => `${per[s.id] ?? 0} ${s.label.toLowerCase()}`),
    `${per[GEEN_STATUS] ?? 0} niet bepaald`,
  ].join(', ');

const meervoud = (n: number, een: string, meer: string) =>
  `${n} ${n === 1 ? een : meer}`;

const pathname = '/roadmap/onderzoeksvragen';
---

<Base
  lang="nl"
  kind="docs"
  pathname={pathname}
  noSearchIndex
  title="Onderzoeksvragen · Roadmap · RegelRecht"
  description="Alle onderzoeksvragen van de RegelRecht-roadmap, met hun stand, deelvragen en verwante vragen."
>
  <RoadmapSectie>
    <RoadmapKop
      huidig="onderzoeksvragen"
      ondertitel="Alle onderzoeksvragen van de werkpakketten. Druk op een vraag voor het doel, de deelvragen en de verwante vragen. Een vraag volgt zijn eigen status, en anders de belegging van zijn werkpakket."
      zoek={{ placeholder: 'Zoek in onderzoeksvragen', noun: 'vragen' }}
      filters={['stand']}
    />

    {/*
      Twee regels tellingen, niet één: de eerste gaat over de vragen zelf
      (eigen status), de tweede over hun werkpakketten. Ze lopen uiteen, en
      dat is precies wat deze pagina zichtbaar wil maken.
    */}
    <nldd-container gap="4">
      <nldd-text size="sm">
        {meervoud(telling.vragen.totaal, 'vraag', 'vragen')}, eigen status:{' '}
        {standenTekst(telling.vragen.perStatus)}.
        {telling.deelvragen.totaal > 0 &&
          ` Daaronder ${meervoud(telling.deelvragen.totaal, 'deelvraag', 'deelvragen')}, ${telling.deelvragen.beantwoord} beantwoord.`}
      </nldd-text>
      <nldd-text size="sm" color="secondary">
        Onderzoek per werkpakket ({telling.werkpakketten.totaal} werkpakketten):{' '}
        {standenTekst(telling.werkpakketten.perStatus)}.
      </nldd-text>
    </nldd-container>

    {/* Dezelfde kolomopbouw als het bord, zodat de kaarten even breed zijn. */}
    <nldd-container layout="grid" column-count="3" sm-column-count="1" gap="8">
      {
        vragen.map(({ vraag, werkpakket, sleutel }) => (
          <RoadmapVraagKaart vraag={vraag} werkpakket={werkpakket} sleutel={sleutel} />
        ))
      }
    </nldd-container>
  </RoadmapSectie>

  {/*
    Het zijpaneel, één voor alle vragen. De titelbalk geeft het paneel zijn
    naam en zijn sluitknop; de sheet vangt `dismiss` zelf op. heading-level 2,
    want de pagina heeft zijn h1 al.
  */}
  <nldd-sheet placement="right" width="520px" accessible-label="Onderzoeksvraag" data-vraag-sheet>
    <nldd-top-title-bar
      text="Onderzoeksvraag"
      heading-level="2"
      back-text=""
      dismiss-text="Sluiten"
    />
    <nldd-container padding="24" sm-padding="16">
      {
        vragen.map(({ vraag, werkpakket, sleutel }) => (
          <RoadmapVraagDetail
            vraag={vraag}
            werkpakket={werkpakket}
            sleutel={sleutel}
            verwanten={verwanten}
          />
        ))
      }
    </nldd-container>
  </nldd-sheet>
</Base>

{/*
  Kaart → paneel. Alles staat al in de DOM; dit script verbergt alle panelen
  op één na en opent de sheet. Gebonden op astro:page-load, om dezelfde reden
  als het zoekscript in RoadmapKop.astro: na een ClientRouter-navigatie is de
  DOM vers en zou een binding op het topniveau niet meer draaien.
*/}
<script>
  function wireVraagPaneel() {
    const sheet = document.querySelector<HTMLElement & { show(): void }>(
      'nldd-sheet[data-vraag-sheet]',
    );
    if (!sheet) return;
    const panelen = Array.from(
      sheet.querySelectorAll<HTMLElement>('[data-vraag-detail]'),
    );
    for (const kaart of document.querySelectorAll<HTMLElement>(
      '.rr-roadmap .rr-wp-card[data-vraag]',
    )) {
      kaart.addEventListener('click', () => {
        for (const paneel of panelen) {
          paneel.hidden = paneel.dataset.vraagDetail !== kaart.dataset.vraag;
        }
        sheet.show();
      });
    }
  }

  document.addEventListener('astro:page-load', wireVraagPaneel);
</script>
