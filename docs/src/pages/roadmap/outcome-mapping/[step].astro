---
/*
 * /roadmap/outcome-mapping/<step> — one step of the worksheet, read-only.
 *
 * The app rendered each step as an editor with autosave, and the two
 * per-partner steps hid three of their four partners behind a segmented
 * control. Here every partner is on the page: without client state there is
 * nothing to switch, and four sections read fine.
 *
 * Built from design-system components throughout: nldd-step-indicator for the
 * seven steps (each one a link), nldd-table for the two grids, nldd-text for
 * every run of text. The components bring their own responsive behaviour —
 * nldd-table is its own scroll container, the step indicator reflows — so this
 * page holds no layout CSS and no media queries.
 *
 * The worksheet is nearly empty at the moment — only mission and the boundary
 * partners are filled — so every field falls back to a "nog niets ingevuld"
 * line rather than rendering as a blank.
 */
import Base from '~/layouts/Base.astro';
import RoadmapNav from '~/components/RoadmapNav.astro';
import {
  STEPS,
  outcomeMapping,
  partnerLabel,
  isLeeg,
  STRATEGY_COLUMNS,
  STRATEGY_ROWS,
  PRACTICE_LABELS,
} from '~/lib/roadmap';
import { renderMarkdown } from '~/lib/roadmap-markdown';

export async function getStaticPaths() {
  return STEPS.map((step) => ({ params: { step: step.id }, props: { step } }));
}

const { step } = Astro.props;
const index = STEPS.findIndex((s) => s.id === step.id);
const heading = `Stap ${index + 1}: ${step.label}`;
const pathname = `/roadmap/outcome-mapping/${step.id}`;

const ws = outcomeMapping;
const partners = ws.boundaryPartners;
const LEEG = 'Nog niets ingevuld.';

// The two markdown steps; everything else is plain strings or tables.
const markdownValue =
  step.section === 'vision' || step.section === 'mission'
    ? renderMarkdown(ws[step.section] as string)
    : '';
---

<Base
  lang="nl"
  kind="docs"
  pathname={pathname}
  noSearchIndex
  title={`${step.label} · Outcome mapping · RegelRecht`}
  description={`${heading} van het outcome-mappingwerkblad.`}
>
  <nldd-simple-section
    sm-padding-bottom="32"
    md-padding-bottom="64"
    lg-padding-bottom="96"
  >
    <nldd-container gap="24">
      <RoadmapNav pathname={pathname} />

      <nldd-title size="1">
        <h1>Outcome mapping</h1>
        <p slot="subtitle">{heading}</p>
      </nldd-title>

      {/* Each step is a link, so the indicator doubles as the navigation and
          shows how far the worksheet has come. */}
      <nldd-step-indicator current={index + 1} accessible-label="Stappen">
        {
          STEPS.map((s) => (
            <nldd-step-indicator-item
              href={`/roadmap/outcome-mapping/${s.id}`}
              text={s.label}
            />
          ))
        }
      </nldd-step-indicator>

      <nldd-container gap="24">
        {/* Vision and Mission: one markdown field each. */}
        {
          (step.section === 'vision' || step.section === 'mission') &&
            (markdownValue ? (
              <nldd-rich-text>
                <Fragment set:html={markdownValue} />
              </nldd-rich-text>
            ) : (
              <nldd-text color="secondary">{LEEG}</nldd-text>
            ))
        }

        {/* Boundary Partners: the four partners, as filled in. */}
        {
          step.section === 'boundaryPartners' && (
            <nldd-list variant="box-tinted">
              {partners.map((partner, i) => (
                <nldd-list-item>
                  <nldd-text-cell
                    overline={`Partner ${i + 1}`}
                    text={isLeeg(partner) ? LEEG : partner}
                    width="full"
                  />
                </nldd-list-item>
              ))}
            </nldd-list>
          )
        }

        {/* Outcome Challenges: one per boundary partner. */}
        {
          step.section === 'outcomeChallenges' && (
            <nldd-list variant="box-tinted">
              {ws.outcomeChallenges.map((challenge, i) => (
                <nldd-list-item>
                  <nldd-text-cell
                    overline={partnerLabel(i)}
                    text={isLeeg(challenge) ? LEEG : challenge}
                    width="full"
                  />
                </nldd-list-item>
              ))}
            </nldd-list>
          )
        }

        {/* Progress Markers: expect / like / love to see, per partner. */}
        {
          step.section === 'progressMarkers' &&
            ws.progressMarkers.map((marker, i) => {
              const groups = [
                { label: 'Expect to see', items: marker.expectToSee },
                { label: 'Like to see', items: marker.likeToSee },
                { label: 'Love to see', items: marker.loveToSee },
              ];
              return (
                <nldd-container gap="12">
                  <nldd-title size="4">
                    <h2>{partnerLabel(i)}</h2>
                  </nldd-title>
                  <nldd-list variant="box-tinted">
                    {groups.map((group) => {
                      const gevuld = group.items.filter(
                        (item) => !isLeeg(item),
                      );
                      return (
                        <nldd-list-item>
                          <nldd-text-cell
                            overline={group.label}
                            text={gevuld.length ? gevuld.join(' · ') : LEEG}
                            width="full"
                          />
                        </nldd-list-item>
                      );
                    })}
                  </nldd-list>
                </nldd-container>
              );
            })
        }

        {/* Strategy Maps: a 2x3 grid per partner. nldd-table brings the header
            semantics and its own horizontal scrolling. */}
        {
          step.section === 'strategyMaps' &&
            ws.strategyMaps.map((map, i) => (
              <nldd-container gap="12">
                <nldd-title size="4">
                  <h2>{partnerLabel(i)}</h2>
                </nldd-title>
                <nldd-table
                  background="tinted"
                  columns="minmax(220px, 1.4fr) repeat(3, minmax(160px, 1fr))"
                  accessible-label={`Strategiekaart voor ${partnerLabel(i)}`}
                >
                  <nldd-table-row slot="header">
                    <nldd-cell width="full" />
                    {STRATEGY_COLUMNS.map((column) => (
                      <nldd-cell width="full">
                        <nldd-text size="sm" weight="bold">
                          {column}
                        </nldd-text>
                      </nldd-cell>
                    ))}
                  </nldd-table-row>
                  {STRATEGY_ROWS.map((row) => (
                    <nldd-table-row>
                      <nldd-text-cell
                        overline={row.code}
                        text={row.label}
                        width="full"
                        vertical-alignment="top"
                      />
                      {STRATEGY_COLUMNS.map((_, k) => {
                        const value = map[row.key][k];
                        return (
                          <nldd-cell width="full" vertical-alignment="top">
                            <nldd-text
                              size="sm"
                              color={isLeeg(value) ? 'secondary' : 'default'}
                            >
                              {isLeeg(value) ? LEEG : value}
                            </nldd-text>
                          </nldd-cell>
                        );
                      })}
                    </nldd-table-row>
                  ))}
                </nldd-table>
              </nldd-container>
            ))
        }

        {/* Organizational Practices: the eight practices and their key
            actions. `disabled` marked a practice as not applicable. */}
        {
          step.section === 'organizationalPractices' && (
            <nldd-table
              background="tinted"
              columns="minmax(280px, 1.2fr) minmax(200px, 1fr)"
              accessible-label="Organizational practices en hun key actions"
            >
              <nldd-table-row slot="header">
                <nldd-cell width="full">
                  <nldd-text size="sm" weight="bold">
                    Practice
                  </nldd-text>
                </nldd-cell>
                <nldd-cell width="full">
                  <nldd-text size="sm" weight="bold">
                    Key actions
                  </nldd-text>
                </nldd-cell>
              </nldd-table-row>
              {PRACTICE_LABELS.map((practice, i) => {
                const p = ws.organizationalPractices[i];
                return (
                  <nldd-table-row>
                    <nldd-text-cell
                      overline={`Practice ${i + 1}`}
                      text={practice.title}
                      supporting-text={
                        p.disabled
                          ? `${practice.nl} — niet van toepassing`
                          : practice.nl
                      }
                      width="full"
                      vertical-alignment="top"
                    />
                    <nldd-cell width="full" vertical-alignment="top">
                      <nldd-text
                        size="sm"
                        color={isLeeg(p.keyActions) ? 'secondary' : 'default'}
                      >
                        {isLeeg(p.keyActions) ? LEEG : p.keyActions}
                      </nldd-text>
                    </nldd-cell>
                  </nldd-table-row>
                );
              })}
            </nldd-table>
          )
        }
      </nldd-container>
    </nldd-container>
  </nldd-simple-section>
</Base>
