                      "properties": {
                        "besluit": { "type": "string" },
                        "op_moment": { "$ref": "#/definitions/date" },
                        "grondslag": { "type": "string" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "executogram": {
      "description": "Een feit dat de cel overkwam: een aanvraag, een levering of een betaling (RFC-022 §1.3). Elk veld is door de cel zelf vastgelegd. Wat een gebeurtenis van een bepaalde naam minstens draagt, zegt het gebeurtenisschema van haar stroom (`chronicle.json`); hier staat de vorm die voor elk executogram geldt, plus die van de betaling die het platform zelf vastlegt.",
      "properties": {
        "intake": { "enum": ["aanvraag", "levering", "betaling"] },
        "fields": {
          "additionalProperties": {
            "properties": {
              "origin": {
                "properties": { "herkomst": { "const": "recorded" } }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": { "pattern": "^(betaling|terugvordering)_(gedaan|gemeld)$" }
            }
          },
          "then": {
            "$ref": "#/definitions/executogram_betaling"
          }
        }
      ]
    },
    "executogram_betaling": {
      "description": "De nakoming van één termijn uit een besluit: `<soort>_gedaan` in de kroniek `betalingen` van de cel die betaalde (kanaal `betaling`), `<soort>_gemeld` in die van de cel die besloot (kanaal `levering`). Draagt de verwijzing naar het besluit waaruit de termijn volgt en het volgnummer van de termijn.",
      "properties": {
        "fields": {
          "required": [
            "zaakkenmerk",
            "bedrag",
            "volgnummer",
            "besluit",
            "schuldenaar",
            "schuldeiser"
          ],
          "properties": {
            "zaakkenmerk": {
              "description": "De zaak van het besluit; de sleutel van de stroom `betalingen`.",
              "properties": { "value": { "type": "string", "minLength": 1 } }
            },
            "bedrag": {
              "description": "Het bedrag van de termijn.",
              "properties": { "value": { "type": "number" } }
            },
            "volgnummer": {
              "description": "Het nummer van de termijn binnen de verplichting, vanaf 1.",
              "properties": { "value": { "type": "integer", "minimum": 1 } }
            },
            "soort": {
              "description": "De soort verplichting.",
              "properties": { "value": { "$ref": "#/definitions/obligation_kind" } }
            },
            "besluit": {
              "description": "De besluit-definitie waaruit de termijn volgt.",
              "properties": { "value": { "type": "string", "minLength": 1 } }
            },
            "besluit_cel": {
              "description": "De cel die het besluit nam.",
              "properties": { "value": { "type": "string", "minLength": 1 } }
            },
            "besluit_kroniek": {
              "description": "De kroniek waarin het decretogram van het besluit ligt: altijd `beschikkingen`.",
              "properties": { "value": { "const": "beschikkingen" } }
            },
            "besluit_gram": {
              "description": "De plek van dat decretogram in die kroniek, vanaf nul. Samen met `besluit_cel` en `besluit_kroniek` de volledige verwijzing `<cel>|<kroniek>|<plek>` naar het besluit, en daarmee naar zijn receipt.",
              "properties": { "value": { "type": "integer", "minimum": 0 } }
            },
            "besluit_op_moment": {
              "description": "Het moment van het besluit.",
              "properties": { "value": { "$ref": "#/definitions/date" } }
            },
            "schuldenaar": {
              "description": "De partij die nakwam.",
              "properties": { "value": { "type": "string" } }
            },
            "schuldeiser": {
              "description": "De partij aan wie nagekomen is.",
              "properties": { "value": { "type": "string" } }
            }
          },
          "dependencies": {
            "besluit_cel": ["besluit_kroniek", "besluit_gram"],
            "besluit_kroniek": ["besluit_cel", "besluit_gram"],
            "besluit_gram": ["besluit_cel", "besluit_kroniek"]
          }
        }
      }
    },
    "lexogram": {
      "description": "Het recht zelf: een versie van een regeling (RFC-022 §1.1). Generiek en compile-time, van geen cel in het bijzonder, en daarom in geen enkele kroniek te vinden: de inhoud is het regelingsbestand onder `corpus/regulation/`, gevalideerd door `schema.json`. De variant staat hier zodat één vocabulaire alle drie de grammen dekt."
    }
  }
}
