                  "items": { "$ref": "#/definitions/termijn" }
                }
              }
            },
            "termijnen_vervallen_door": {
              "description": "Het besluit dat in de plaats kwam vóór de bekendmaking, waardoor er niets meer in te roosteren viel; `null` als dat niet speelde.",
              "allOf": [{ "$ref": "#/definitions/besluit_field" }],
              "properties": {
                "value": {
                  "anyOf": [
                    { "type": "null" },
                    {
                      "type": "object",
                      "required": ["besluit", "op_moment", "grondslag"],
