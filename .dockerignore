.git
.worktrees
target
node_modules
frontend
# Keep the editor frontend's manifest: the lawmaking image build runs the
# npm-workspace `npm ci`, which needs every workspace package.json present.
# docs builds from its own lockfile in docs/, admin has no node stage, and the
# editor image uses frontend/Dockerfile.dockerignore instead of this file.
!frontend/package.json
# Een patroon zonder slash matcht alleen op de contextroot: `*` loopt niet over
# een `/` heen. De drie regels hieronder raken dus uitsluitend de losse
# bestanden daar; docs/**/*.md, schema/**/*.json en packages/*/Cargo.toml
# blijven ongemoeid en hoeven niet heringesloten te worden.
*.md
*.png
*.json
!package.json
!package-lock.json
.vscode
.idea
# Exclude .claude but keep skill files needed by the enrich worker image.
# Docker requires un-excluding each path component from parent to child.
.claude
!.claude/skills
.claude/skills/*
!.claude/skills/law-generate
!.claude/skills/law-mvt-research
!.claude/skills/law-reverse-validate
.pytest_cache
__pycache__
.github
